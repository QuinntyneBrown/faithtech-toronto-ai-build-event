@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam classBackgroundColor #F9FAFB
skinparam classBorderColor #344054
skinparam sequenceMessageAlign center
skinparam maxMessageSize 180
title Structure - Configure prizes and inspect eligibility
interface IPrizeService {
  +state: Signal<PrizeView[]>
  +refresh(): Promise<void>
}
class PrizeService {
  -http: HttpClient
  +refresh(): Promise<void>
}
class ConfigurePrizesHandler {
  -store: IEventStore
  +Handle(request: SavePrizeCommand): Task<PrizeView>
}
interface IEventStore {
  +LoadPrize(scope: ActorEventScope): Task<Prize>
  +Commit(intent: OperationContext): Task<CommitResult>
}
class Prize {
  +Id: Guid
  +EventId: Guid
  +Name: string
  +Description: string?
  +AwardId: Guid?
  +Edit(input: PrizeInput): ValidationResult
  +CanRemove(): bool
}
PrizeService ..|> IPrizeService
ConfigurePrizesHandler --> IEventStore : queries / commits through
ConfigurePrizesHandler --> Prize : enforces policy on
class RaffleEligibility {
  +EventId: Guid
  +EligibleParticipantIds: Guid[]
  +Count: int
  +EvaluatedAtUtc: DateTimeOffset
}
class RaffleAward {
  +Id: Guid
  +PrizeId: Guid
  +ParticipantId: Guid
  +PrizeName: string
  +PrizeDescription: string?
  +AwardedAtUtc: DateTimeOffset
}
Prize "1" --> "0..1" RaffleAward
RaffleEligibility ..> RaffleAward : excludes prior winners

@enduml
