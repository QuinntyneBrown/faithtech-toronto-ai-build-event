@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers - Configure prizes and inspect eligibility
Person(actor, "Administrator", "configure prizes")
System_Boundary(system, "FaithTech event platform") {
Container(ui, "Admin application", "Angular", "ConfigurePrizesPage")
Container(api, "Event API", ".NET 10 / MediatR 12.5.0", "Maintain prize identities and inspect current eligible participants")
ContainerDb(db, "Event database", "SQL Server", "Prize definitions and immutable award snapshots")
ContainerDb(redis, "Fanout backplane", "Redis; multiple API instances only", "Transient notification transport")
}
Rel(actor, ui, "Configure prizes")
Rel(ui, api, "Typed requests and state reads", "JSON / HTTPS")
Rel(api, db, "Commit or query scoped state", "EF Core")
Rel(api, redis, "EventHub fanout between instances")
Rel(api, ui, "Committed outbox invalidations through EventHub", "SignalR / HTTPS")

@enduml
