@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components - Draw and present a raffle winner
Container(ui, "DrawWinnerPage", "Angular / IRaffleService", "Signals and typed service contract")
Container_Boundary(api, "Event API") {
Component(ctrl, "RaffleController", "ASP.NET Core", "Bind, MediatR dispatch, return")
Component(gate, "SessionAuthorizationBehavior", "Application pipeline", "Validate actor, event and ownership")
Component(handler, "DrawWinnerHandler", "Application", "Choose a uniform eligible identity once before any optional celebration")
Component(entity, "RaffleAward", "Domain", "Atomic prize awards, intent receipts and retained winner snapshots")
Component(store, "SqlEventStore", "Infrastructure / IEventStore", "Feature queries, concurrency and transactions")
}
ContainerDb(db, "Event database", "SQL Server", "Atomic prize awards, intent receipts and retained winner snapshots")
Rel(ui, ctrl, "Draw winner", "HTTPS")
Rel(ctrl, gate, "Dispatch request through pipeline")
Rel(gate, handler, "Continue authorized request")
Rel(handler, entity, "Apply domain policy")
Rel(handler, store, "Load and persist through port")
Rel(store, db, "Query or commit", "EF Core")
@enduml
