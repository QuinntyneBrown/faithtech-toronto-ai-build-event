@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam classBackgroundColor #F9FAFB
skinparam classBorderColor #344054
skinparam sequenceMessageAlign center
skinparam maxMessageSize 180
title Structure - Draw and present a raffle winner
interface IRaffleService {
  +state: Signal<RaffleResult>
  +refresh(): Promise<void>
}
class RaffleService {
  -http: HttpClient
  +refresh(): Promise<void>
}
class DrawWinnerHandler {
  -store: IEventStore
  +Handle(request: DrawWinnerCommand): Task<RaffleResult>
}
interface IEventStore {
  +LoadRaffleAward(scope: ActorEventScope): Task<RaffleAward>
  +Commit(intent: OperationContext): Task<CommitResult>
}
class RaffleAward {
  +Id: Guid
  +EventId: Guid
  +PrizeId: Guid
  +ParticipantId: Guid
  +PrizeName: string
  +PrizeDescription: string?
  +AwardedAtUtc: DateTimeOffset
  +ToResult(): RaffleResult
}
RaffleService ..|> IRaffleService
DrawWinnerHandler --> IEventStore : queries / commits through
DrawWinnerHandler --> RaffleAward : enforces policy on
interface IRandomSource {
  +NextExclusive(maximum: int): int
}
class RafflePresentation {
  +AwardId: string
  +ReducedMotion: boolean
  +SoundEnabled: boolean
  +Present(result: RaffleResult): Promise<void>
  +Stop(): void
}
DrawWinnerHandler --> IRandomSource : uniform eligible index
RafflePresentation ..> RaffleAward : displays saved result only

@enduml
