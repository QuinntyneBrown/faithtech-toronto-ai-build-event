@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components - Accessible event experience
Container_Boundary(app, "Each Angular application") {
Component(shell, "AppShell and routed pages", "Application project", "Routing, headings and dialogs")
Component(domain, "Domain compositions", "domain library", "Signals and injected service contracts")
Component(primitives, "Presentational primitives", "components library", "Inputs, outputs, native semantics and token styles")
Component(adapter, "BrowserCapabilityService", "api library", "IBrowserCapabilityService browser adapter")
}
Rel(shell, domain, "Composes feature state")
Rel(shell, primitives, "Composes presentational controls")
Rel(domain, primitives, "Renders inputs and handles outputs")
Rel(domain, adapter, "Consumes through BROWSER_CAPABILITY_SERVICE")
@enduml
