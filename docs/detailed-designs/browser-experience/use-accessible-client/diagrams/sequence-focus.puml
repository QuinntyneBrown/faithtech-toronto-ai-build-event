@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam classBackgroundColor #F9FAFB
skinparam classBorderColor #344054
skinparam sequenceMessageAlign center
skinparam maxMessageSize 180
title Keyboard dialog and validation recovery
actor "Keyboard user" as user
box "Frontend - Client or admin application" #E0F2FE
participant "Routed page" as page
participant "Application dialog" as dialog
participant "FormFeedback / status region" as feedback
end box
user -> page : Activate dialog trigger [L2-036]
page -> dialog : Open and retain trigger reference
dialog --> user : Initial focus inside modal
user -> dialog : Tab / Shift+Tab
dialog --> user : Focus remains within open dialog
alt Validation failure
dialog -> feedback : Errors with linked field paths; retain draft
feedback --> user : Announce summary and expose field recovery
else Close or cancel
dialog -> page : Return focus to trigger if present
alt Trigger removed
page --> user : Focus relevant heading or next action
else Trigger present
page --> user : Restore trigger focus
end
end
@enduml
