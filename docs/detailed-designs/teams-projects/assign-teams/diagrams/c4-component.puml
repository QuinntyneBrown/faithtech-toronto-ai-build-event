@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components - Assign participants to teams
Container(ui, "AssignTeamsPage", "Angular / ITeamService", "Signals and typed service contract")
Container_Boundary(api, "Event API") {
Component(ctrl, "TeamController", "ASP.NET Core", "Bind, MediatR dispatch, return")
Component(gate, "SessionAuthorizationBehavior", "Application pipeline", "Validate actor, event and ownership")
Component(handler, "AssignTeamsHandler", "Application", "Enforce one team per participant and confirm balanced random assignments")
Component(entity, "Team", "Domain", "Teams, memberships, assignment previews and assignment versions")
Component(store, "SqlEventStore", "Infrastructure / IEventStore", "Feature queries, concurrency and transactions")
}
ContainerDb(db, "Event database", "SQL Server", "Teams, memberships, assignment previews and assignment versions")
Rel(ui, ctrl, "Assign teams", "HTTPS")
Rel(ctrl, gate, "Dispatch request through pipeline")
Rel(gate, handler, "Continue authorized request")
Rel(handler, entity, "Apply domain policy")
Rel(handler, store, "Load and persist through port")
Rel(store, db, "Query or commit", "EF Core")
@enduml
