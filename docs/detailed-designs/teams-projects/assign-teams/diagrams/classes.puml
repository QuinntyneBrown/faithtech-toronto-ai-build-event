title Structure - Assign participants to teams
interface ITeamService {
  +state: Signal<TeamView[]>
  +refresh(): Promise<void>
}
class TeamService {
  -http: HttpClient
  +refresh(): Promise<void>
}
class AssignTeamsHandler {
  -store: IEventStore
  +Handle(request: SetMembershipCommand): Task<TeamView>
}
interface IEventStore {
  +LoadTeam(scope: ActorEventScope): Task<Team>
  +Commit(intent: OperationContext): Task<CommitResult>
}
class Team {
  +Id: Guid
  +EventId: Guid
  +Name: string
  +SelectedProjectId: Guid?
  +CanRemove(members: int, hasDemo: bool): bool
}
TeamService ..|> ITeamService
AssignTeamsHandler --> IEventStore : queries / commits through
AssignTeamsHandler --> Team : enforces policy on
class Membership {
  +EventId: Guid
  +ParticipantId: Guid
  +TeamId: Guid
}
class AssignmentPreview {
  +Id: Guid
  +EventId: Guid
  +InputVersion: string
  +Mode: AssignmentMode
  +Assignments: Membership[]
}
Team "1" <-- "0..*" Membership
AssignmentPreview "1" o-- "0..*" Membership : proposed assignments

@enduml
