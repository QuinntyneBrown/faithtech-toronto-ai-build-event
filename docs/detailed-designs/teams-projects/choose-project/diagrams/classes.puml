@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam classBackgroundColor #F9FAFB
skinparam classBorderColor #344054
skinparam sequenceMessageAlign center
skinparam maxMessageSize 180
title Structure - Choose an event project
interface IProjectService {
  +state: Signal<ProjectDetail>
  +refresh(): Promise<void>
}
class ProjectService {
  -http: HttpClient
  +refresh(): Promise<void>
}
class ChooseProjectHandler {
  -store: IEventStore
  +Handle(request: SelectProjectCommand): Task<ProjectDetail>
}
interface IEventStore {
  +LoadAuthorized(scope: ActorEventScope): Task<ProjectChoice>
  +Commit(intent: OperationContext): Task<CommitResult>
}
class ProjectChoice {
  +Id: Guid
  +EventId: Guid
  +Name: string
  +Description: string
  +Guidance: string?
  +ProposedById: Guid?
  +LiturgyUrl: Uri?
  +Revise(input: ProjectInput): ValidationResult
}
ProjectService ..|> IProjectService
ChooseProjectHandler --> IEventStore : queries / commits through
ChooseProjectHandler --> ProjectChoice : enforces policy on
class Team {
  +Id: Guid
  +EventId: Guid
  +SelectedProjectId: Guid?
  +Select(projectId: Guid?): void
}
class GuidanceLink {
  +Label: string
  +Url: Uri
}
class DemoSlot {
  +TeamId: Guid
  +ProjectId: Guid
}
ProjectChoice "1" *-- "0..*" GuidanceLink
ProjectChoice "0..1" <-- "0..*" Team : current selection
Team "1" --> "0..1" DemoSlot

@enduml
