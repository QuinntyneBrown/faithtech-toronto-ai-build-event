@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers - Choose an event project
Person(actor, "Participant and administrator", "choose project")
System_Boundary(system, "FaithTech event platform") {
Container(ui, "Client and admin applications", "Angular", "ChooseProjectPage")
Container(api, "Event API", ".NET 10 / MediatR 12.5.0", "Accept event-owned proposals and atomically change a team project")
ContainerDb(db, "Event database", "SQL Server", "Project catalog, guidance links, team selections and demo project references")
ContainerDb(redis, "Fanout backplane", "Redis; multiple API instances only", "Transient notification transport")
}
Rel(actor, ui, "Choose project")
Rel(ui, api, "Typed requests and state reads", "JSON / HTTPS")
Rel(api, db, "Commit or query scoped state", "EF Core")
Rel(api, redis, "EventHub fanout between instances")
Rel(api, ui, "Committed outbox invalidations through EventHub", "SignalR / HTTPS")

@enduml
