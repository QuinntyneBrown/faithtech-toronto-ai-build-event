@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam roundcorner 8
autonumber
title Measure real API and connected render latency
actor "Deployment operator" as actor
box "Frontend — Instrumented companion clients" #E0F2FE
participant "Load driver / render observations" as page
participant "HTTP / SignalR service adapters" as client
end box
box "Backend — Companion API" #D1FADF
participant "Feature controllers" as controller
end box
box "Backend — Application and Domain" #ECFDF3
participant "Feature command / query handlers" as handler
end box
box "Backend — Infrastructure" #FFF4E5
database "Companion SQL database" as db
participant "EventChangePublisher" as push
end box
actor -> page : Start isolated baseline workload
page -> client : 2m warmup then 10m, 200 viewers / 2 admins
loop Each measured operation
 client -> controller : Real HTTP request and SignalR connection
 controller -> handler : Dispatch read / mutation
 handler -> db : Read or commit durable state
 db --> handler : Version and commit time
 handler --> controller : Result
 controller --> client : API timing observation
 push -> client : SignalR invalidation
 client -> page : Apply authoritative snapshot; record render time
end
page -> page : Separate intentional rejects, missing observations and drops
page --> actor : API p95, error rate, every observed render, environment L2-043
@enduml
