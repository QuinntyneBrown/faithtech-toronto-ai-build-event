@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam roundcorner 8
autonumber
title Restore isolated state and revoke previous access
actor "Deployment operator" as actor
box "Operator — Isolated recovery tools" #E0F2FE
participant "Runbook operator actions" as page
participant "SQL restore client / private verification client" as client
end box
box "Backend — Companion API" #D1FADF
participant "Readiness / authorized projection endpoints" as controller
end box
box "Backend — Application and Domain" #ECFDF3
participant "Readiness / snapshot / session query handlers" as handler
end box
box "Backend — Infrastructure" #FFF4E5
database "Companion SQL database" as db
end box
actor -> page : Choose backup and distinct isolated target
page -> client : Verify explicit target and disabled traffic
client -> db : Restore backup into isolated database
 db --> client : Restore complete
client -> db : Check consistency and schema
 db --> client : Coherent database
client -> db : Maintenance transaction: revoke all sessions/receipts
client -> db : Supported credential rotation; commit L2-045
 db --> client : New revision; old access invalid
client -> controller : Readiness and authorized state verification
controller -> handler : Dispatch verification queries
handler -> db : Read participants, teams, projects, stage and draws
 db --> handler : Restored coherent state
handler --> controller : Authorized snapshots
controller --> client : Verification results
client --> page : Counts, versions, old-session rejection evidence
page --> actor : Recovery record; traffic stays isolated until cutover
@enduml
