@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
Person(operator, "Deployment operator")
System_Ext(tools, "Operator tools", "SQL client, HTTPS diagnostics and protected scheduler")
System_Boundary(companion, "FaithTech companion") {
Container(app, "Companion client", "Angular", "Real participant and admin journeys")
Container(api, "Companion API", "ASP.NET Core", "Readiness, requests and SignalR")
ContainerDb(db, "Companion database", "SQL Server", "Durable event and access state")
}
System_Ext(backup, "Protected backup storage", "Separate restore source")
Rel(operator, tools, "Follows runbook")
Rel(tools, api, "Checks readiness and authorized snapshots", "HTTPS")
Rel(tools, db, "Initializes / backs up / restores isolated target", "Encrypted SQL")
Rel(db, backup, "Writes scheduled backups")
Rel(tools, backup, "Selects restore source")
Rel(app, api, "Measured HTTP / SignalR")
Rel(api, db, "Reads and commits")

@enduml
