@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
 BorderColor #344054
 FontColor #101828
 BackgroundColor #F9FAFB
}
title Manage event data through validated commands - create or update draft
actor Operator as op
box "Frontend - Windows terminal" #E0F2FE
participant "Event command" as cli
end box
box "Backend - Application" #ECFDF3
participant "Event maintenance handler" as handler
participant "Application validators" as rules
end box
box "Backend - Infrastructure" #FFF4E5
participant SqlEventMaintenanceStore as store
database EventDbContext as db
end box
op -> cli : Preview create or update
cli -> handler : Proposed event fields
handler -> rules : Normalize merged state [L2-052]
rules --> handler : Valid draft or field errors
handler --> cli : Preview with identity and version
cli --> op : Review proposed changes
op -> cli : Explicit apply
cli -> handler : Approved intent
handler -> store : Apply with verified actor
store -> db : Begin; lock operation; read receipt
alt Already committed
db --> store : Saved nonsecret outcome
else New operation
store -> db : Lock event; compare reviewed version
store -> rules : Validate current proposed aggregate
alt Validation or concurrency failure
rules --> store : Reject
store -> db : Roll back
else Valid
store -> db : Save draft + receipt + audit + invalidation
store -> db : Commit [L2-058]
end
end
store --> handler : Confirmed or unconfirmed outcome
handler --> cli : Typed result
cli --> op : Result and exit code
@enduml
