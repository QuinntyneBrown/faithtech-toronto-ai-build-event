@startuml
title Manage event data through validated commands - containers
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
Person(op, "Database operator")
System_Boundary(local, "Operator machine") {
Container(cli, "Provisioning CLI", ".NET 10", "Validated event, schedule and publication maintenance")
ContainerDb(files, "Operator files", "Protected local storage", "Configuration, previews and journal")
}
System_Boundary(azure, "Azure production") {
ContainerDb(db, "Event database", "Azure SQL", "Application data and operation receipts")
Container(api, "Event API", "ASP.NET Core", "Existing application reads and sessions")
}
Rel(op, cli, "Uses", "Terminal")
Rel(cli, files, "Reads and writes")
Rel(cli, db, "Connects directly", "Encrypted SQL")
Rel(api, db, "Reads committed state", "EF Core")
@enduml
