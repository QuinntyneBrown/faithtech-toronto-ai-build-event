@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
 BorderColor #344054
 FontColor #101828
 BackgroundColor #F9FAFB
}
title Manage event data through validated commands - inspect event data
actor Operator as op
box "Frontend - Windows terminal" #E0F2FE
participant "Event command" as cli
end box
box "Backend - Application" #ECFDF3
participant "Event maintenance handler" as handler
participant "Application validators" as rules
end box
box "Backend - Infrastructure" #FFF4E5
participant SqlEventMaintenanceStore as store
database EventDbContext as db
end box
op -> cli : events list or show; explicit target
cli -> handler : Event query [L2-052]
handler -> store : Read selected event(s)
store -> db : Query event and schedule projection
db --> store : Saved configuration and rowversion
store --> handler : Projection or not found
handler --> cli : Authorized operator result
cli --> op : IDs, publication state and versions
@enduml
