@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
 BorderColor #344054
 FontColor #101828
 BackgroundColor #F9FAFB
}
title Manage event data through validated commands - replace schedule
actor Operator as op
box "Frontend - Windows terminal" #E0F2FE
participant "Event command" as cli
end box
box "Backend - Application" #ECFDF3
participant "Event maintenance handler" as handler
participant "Application validators" as rules
end box
box "Backend - Infrastructure" #FFF4E5
participant SqlEventMaintenanceStore as store
database EventDbContext as db
end box
op -> cli : events schedule --preview
cli -> handler : Complete schedule and expected version
handler -> rules : Normalize stages and windows
rules --> handler : Valid replacement or errors
handler --> cli : Stage additions/removals preview
cli --> op : Review; explicit apply
op -> cli : Apply reviewed schedule
cli -> handler : Approved schedule intent
handler -> store : Apply
store -> db : Lock event; load old schedule and SQL time
store -> rules : Check closure and new intervals [L2-052]
alt Reopen, overlap, stale or foreign stage
rules --> store : Conflict
store -> db : Roll back
else Valid replacement
store -> db : Replace stages/windows; preserve history
store -> db : Commit receipt, audit and invalidation
end
store --> handler : Outcome
handler --> cli : Result
cli --> op : Saved schedule or field conflict
@enduml
