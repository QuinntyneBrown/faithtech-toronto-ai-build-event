@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
 BorderColor #344054
 FontColor #101828
 BackgroundColor #F9FAFB
}
title Manage event data through validated commands - publish a complete event
actor Operator as op
box "Frontend - Windows terminal" #E0F2FE
participant "Event command" as cli
end box
box "Backend - Application" #ECFDF3
participant "Event maintenance handler" as handler
participant "Application validators" as rules
end box
box "Backend - Infrastructure" #FFF4E5
participant SqlEventMaintenanceStore as store
database EventDbContext as db
end box
op -> cli : events publish --preview
cli -> handler : Event ID and version
handler -> store : Load publication candidate
store -> db : Read complete event
db --> store : Candidate
store --> handler : Configuration
handler -> rules : Validate title, schedule, location and logo
alt Missing or invalid fields
rules --> handler : Field-specific failures
handler --> cli : Draft remains unchanged
else Publishable
rules --> handler : Valid
handler --> cli : Publish preview
cli --> op : Explicit approval
op -> cli : Apply
cli -> handler : Approved publication
handler -> store : Lock, revalidate and publish
store -> db : Commit publication + receipt + audit + invalidation
store --> handler : Published state and version
handler --> cli : Committed result
end
cli --> op : Publication outcome
@enduml
