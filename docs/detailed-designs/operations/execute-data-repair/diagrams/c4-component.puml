@startuml
title Execute explicitly reviewed SQL data repairs - components
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
Container_Boundary(local_process, "Local Provisioning process") {
Component(cmd, "SqlExecuteCommand", "Provisioning", "Binds script and parameter files")
Component(handler, "ExecuteSqlRepairHandler", "Application", "Coordinates explicit approved execution")
Component(reader, "SqlScriptReader and SqlBatchReader", "Application", "Preserves source and parses batch boundaries")
Component(executor, "SqlRepairExecutor", "Infrastructure", "Runs batches without retry")
Component(journal, "FileOperatorJournal", "Infrastructure", "Records attempts and checkpoints")
}
ContainerDb(db, "Event database", "SQL Server", "Durable data")
Rel(cmd, handler, "Dispatches SQL intent")
Rel(handler, reader, "Reads script contract")
Rel(handler, executor, "Executes approved batches")
Rel(executor, journal, "Flushes start before SQL")
Rel(executor, db, "Binds parameters; drains all results")
@enduml
