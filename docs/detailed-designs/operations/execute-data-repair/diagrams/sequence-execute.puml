@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
 BorderColor #344054
 FontColor #101828
 BackgroundColor #F9FAFB
}
title Execute explicitly reviewed SQL data repairs - execute and export results
actor Operator as op
box "Frontend - Windows terminal" #E0F2FE
participant "SqlExecuteCommand" as cli
end box
box "Backend - Application" #ECFDF3
participant ExecuteSqlRepairHandler as handler
end box
box "Backend - Infrastructure" #FFF4E5
participant SqlRepairExecutor as sql
database "Operator journal" as journal
database "Verified SQL connection" as db
end box
op -> cli : Explicit apply of reviewed SQL
cli -> handler : Bound preview and target
handler -> sql : Execute once [L2-056]
sql -> journal : Lock ID; flush Started [L2-059]
alt Journal unavailable or prior attempt exists
journal --> sql : Refuse execution
else Start recorded
journal --> sql : Durable start
loop Each approved batch
sql -> db : Execute with bound parameters
loop Each result set
db --> sql : Typed columns and rows
sql --> cli : Write protected result spool
end
sql -> db : Inspect transaction state
db --> sql : Completed or committed checkpoint
sql -> journal : Record nonsecret checkpoint
end
sql --> handler : Database outcome
handler --> cli : Finalize text/JSON or requested export
end
cli --> op : Result; exit 7 if committed but delivery failed
@enduml
