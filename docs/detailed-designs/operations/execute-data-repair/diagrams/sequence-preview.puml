@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
 BorderColor #344054
 FontColor #101828
 BackgroundColor #F9FAFB
}
title Execute explicitly reviewed SQL data repairs - preview exact SQL
actor Operator as op
box "Frontend - Windows terminal" #E0F2FE
participant "SqlExecuteCommand" as cli
end box
box "Backend - Application" #ECFDF3
participant ExecuteSqlRepairHandler as handler
end box
box "Backend - Infrastructure" #FFF4E5
participant SqlRepairExecutor as sql
database "Operator journal" as journal
database "Verified SQL connection" as db
end box
op -> cli : sql execute --file repair.sql --preview
cli -> handler : Script bytes and parameter input
handler -> handler : Validate UTF-8, GO boundaries and typed parameters
alt Unsupported directive or malformed input
handler --> cli : Validation error; no supplied SQL sent
else Accepted contract
handler -> sql : Verify target identity only [L2-050]
sql -> db : Fixed connection identity query
db --> sql : Actual target and principal
sql --> handler : Verified target
handler --> cli : Exact script, placeholders and preview ID [L2-056]
end
cli --> op : No affected-row prediction
@enduml
