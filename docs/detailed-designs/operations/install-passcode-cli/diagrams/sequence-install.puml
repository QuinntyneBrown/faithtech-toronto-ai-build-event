@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam roundcorner 8
autonumber
title Package and install or update local source
actor "Database operator" as actor
box "Operator — installed .NET tool" #E0F2FE
participant "OperatorRootCommand" as page
participant "IOperatorTargetService" as client
end box
box "Backend — SQL operation boundary" #D1FADF
participant "VerifyConnectionCommand" as controller
end box
box "Backend — Application and Domain" #ECFDF3
participant "VerifyConnectionHandler" as handler
participant "OperatorTargetProfile" as entity
end box
box "Backend — Infrastructure" #FFF4E5
database "Companion SQL database" as db
participant "EventChangePublisher" as push
end box
actor -> page : Run Install-OperatorTool.ps1
page -> page : Resolve source, SDK and unique local version
page -> page : Build and pack into temporary package source L2-049
alt Build or package fails
 page --> actor : Failure; existing tool remains runnable
else Package ready
 page -> client : Inspect installed tool identity/version
 alt Not installed
  client -> client : dotnet tool install exact local package
 else Installed
  client -> client : dotnet tool update exact local package
 end
 client --> page : Installation result
 page -> page : Run version/help outside checkout
 page --> actor : Verified executable and version
end
@enduml
