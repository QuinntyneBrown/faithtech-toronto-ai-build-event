@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam classBackgroundColor #F9FAFB
skinparam classBorderColor #344054
skinparam sequenceMessageAlign center
skinparam maxMessageSize 180
title Validate startup and inspect readiness
actor "Operator" as operator
box "Backend - Event API" #D1FADF
participant "Host / Options validation" as host
participant "Private health endpoints" as health
end box
box "Backend - Infrastructure" #FFF4E5
database "SQL Server" as sql
participant "Safe monitoring" as monitoring
end box
operator -> host : Start with protected configuration [L2-045]
alt Missing or invalid required configuration
host --> operator : Actionable field names; no secret values
else Valid configuration
host -> sql : Check connectivity and schema readiness
sql --> host : Dependency result
host -> monitoring : Record safe startup status
operator -> health : Authenticated management readiness request
health -> sql : Probe dependency
sql --> health : Readiness result
health --> operator : Ready or redacted unavailable status
end
@enduml
