@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam classBackgroundColor #F9FAFB
skinparam classBorderColor #344054
skinparam sequenceMessageAlign center
skinparam maxMessageSize 180
title Measure the real event acceptance baseline
actor "Operator" as operator
box "Verification - Real API load harness" #FFF4E5
participant "Load coordinator" as load
participant "Browser render probes" as browser
end box
box "Backend - Event API" #D1FADF
participant "API / EventHub" as api
end box
operator -> load : Configure 200 participants and two administrators [L2-043]
loop Ten runs
load -> api : Warm for two minutes
load -> api : Measure ten minutes; reads 5s, participant writes 30s, admin writes 60s
api --> load : Correlated real responses and errors
api -> browser : Scheduled transition and committed raffle invalidations
browser --> load : Save/boundary-to-render samples
end
load -> api : Separate 200-answer burst within one second
api --> load : Admission and durable answer results
alt Any latency, update or failure threshold exceeded
load --> operator : Failed acceptance with raw evidence
else All thresholds met
load --> operator : Bounded pass with environment and all ten run reports
end
@enduml
