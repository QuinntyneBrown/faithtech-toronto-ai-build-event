@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components - Operate and measure the platform
Container_Boundary(api, "Event API") {
Component(options, "EventPlatformOptions validators", "Microsoft.Extensions.Options", "Fail redacted startup validation")
Component(controller, "DiagnosticController", "ASP.NET Core", "Bind and dispatch GetDiagnosticsQuery")
Component(handler, "OperateEventHandler", "Application", "Reads safe status through IDiagnosticReader")
Component(probes, "SQL / outbox / admission probes", "Infrastructure", "Dependency status and operational lag")
Component(metrics, "Logging, metrics and audit adapters", "Microsoft.Extensions", "Correlation and sensitive-field exclusion")
}
Rel(options, probes, "Provides validated configuration")
Rel(controller, handler, "Dispatches authorized query")
Rel(handler, probes, "Reads status through port")
Rel(probes, metrics, "Publishes safe measurements")
@enduml
