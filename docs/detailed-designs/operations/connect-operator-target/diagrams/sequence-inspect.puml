@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
 BorderColor #344054
 FontColor #101828
 BackgroundColor #F9FAFB
}
title Connect to an explicit operator target - inspect target
actor Operator as op
box "Frontend - Windows terminal" #E0F2FE
participant "TargetInspectCommand" as cli
end box
box "Backend - Application" #ECFDF3
participant ResolveOperatorTargetHandler as handler
end box
box "Backend - Infrastructure" #FFF4E5
participant SqlOperatorConnectionFactory as factory
database "Protected local secrets" as files
database "Selected Azure SQL" as db
end box
op -> cli : target inspect --target production
cli -> handler : Explicit profile [L2-050]
handler -> factory : Open verified connection
factory -> files : Decrypt referenced secret [L2-051]
files --> factory : In-memory connection settings
alt Missing or insecure configuration
factory --> handler : Redacted configuration error
else Valid settings
factory -> db : Open encrypted SQL and read identity
alt Authentication or network failure
db --> factory : Connection failure
factory --> handler : Redacted stage and outcome
else Connected
db --> factory : Server, database, SID and names
factory --> handler : VerifiedConnection
end
end
handler --> cli : Target identity or failure
cli --> op : Text or JSON; no fallback
@enduml
