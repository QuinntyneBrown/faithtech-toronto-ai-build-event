@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
 BorderColor #344054
 FontColor #101828
 BackgroundColor #F9FAFB
}
title Connect to an explicit operator target - attribute a validated operation
actor Operator as op
box "Frontend - Windows terminal" #E0F2FE
participant "ApplyOperationCommand" as cli
end box
box "Backend - Application" #ECFDF3
participant OperatorMutationHandler as handler
end box
box "Backend - Infrastructure" #FFF4E5
participant SqlOperatorIdentityStore as ids
database EventDbContext as db
end box
op -> cli : Apply reviewed intent
cli -> handler : Verified principal and payload
handler -> db : Begin transaction
handler -> ids : Resolve actor by target and SID
ids -> db : Lock identity key; find or insert [L2-051]
db --> ids : Operator ActorId
ids --> handler : ActorKind DatabaseOperator
handler -> db : Mutation + receipt + audit [L2-058]
db --> handler : Commit confirmed
handler --> cli : Attributed outcome
cli --> op : Result
@enduml
