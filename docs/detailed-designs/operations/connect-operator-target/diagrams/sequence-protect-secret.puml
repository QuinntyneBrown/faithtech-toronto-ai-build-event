@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
 BorderColor #344054
 FontColor #101828
 BackgroundColor #F9FAFB
}
title Connect to an explicit operator target - configure protected credentials
actor Operator as op
box "Frontend - Windows terminal" #E0F2FE
participant "TargetSetSecretCommand" as cli
end box
box "Backend - Infrastructure" #FFF4E5
participant ProtectedOperatorSecretStore as store
participant "Windows DPAPI" as dpapi
database "Operator-only directory" as files
end box
op -> cli : Secret reference and masked input
cli -> store : Protect value [L2-051]
store -> dpapi : Encrypt with CurrentUser
alt Encryption or ACL failure
dpapi --> store : Protection failure
store --> cli : Redacted failure; no plaintext write
else Protected
dpapi --> store : Encrypted bytes
store -> files : Atomic write with restricted ACL
files --> store : Saved reference
store --> cli : Reference only
end
cli --> op : Result without secret
@enduml
