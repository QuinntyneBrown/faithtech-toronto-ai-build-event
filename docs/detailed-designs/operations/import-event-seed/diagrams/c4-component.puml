@startuml
title Import an event seed without losing event history - components
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
Container_Boundary(local_process, "Local Provisioning process") {
Component(cmd, "ImportEventSeedCommand", "Provisioning", "Chooses create or explicit update")
Component(reader, "SeedEnvelopeReader", "Application", "Strict JSON and field presence")
Component(handler, "ImportEventSeedHandler", "Application", "Merges and validates seed intent")
Component(store, "SqlEventMaintenanceStore.Import", "Infrastructure", "Single import transaction")
Component(mutations, "SqlEventMutations", "Infrastructure", "Shared event and schedule changes")
}
ContainerDb(db, "Event database", "SQL Server", "Durable data")
Rel(cmd, reader, "Reads explicit seed file")
Rel(reader, handler, "Returns typed envelope")
Rel(handler, store, "Applies reviewed import")
Rel(store, mutations, "Changes one tracked aggregate")
Rel(store, db, "Commits event, schedule, audit and receipt")
@enduml
