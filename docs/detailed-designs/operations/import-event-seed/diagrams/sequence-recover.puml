@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
 BorderColor #344054
 FontColor #101828
 BackgroundColor #F9FAFB
}
title Import an event seed without losing event history - recover interrupted import
actor Operator as op
box "Frontend - Windows terminal" #E0F2FE
participant "ImportEventSeedCommand" as cli
end box
box "Backend - Application" #ECFDF3
participant ImportEventSeedHandler as handler
participant SeedEnvelopeReader as reader
end box
box "Backend - Infrastructure" #FFF4E5
participant SqlEventMaintenanceStore as store
database EventDbContext as db
end box
op -> cli : Retry original operation after lost response
cli -> handler : Same target, principal and operation ID
handler -> store : Reconcile original payload
store -> db : Acquire operation lock; inspect receipt
alt Receipt matches original fingerprint
db --> store : Committed event ID and result
store --> handler : Previously completed; no mutation
else Receipt has different fingerprint
store --> handler : Operation conflict; no mutation
else No receipt after failed transaction
store -> db : Verify original version and validation
store -> db : Apply complete import or reject stale state
store --> handler : Confirmed result
end
handler --> cli : Reconciled or conflicting outcome
cli --> op : No duplicate event or stages
@enduml
