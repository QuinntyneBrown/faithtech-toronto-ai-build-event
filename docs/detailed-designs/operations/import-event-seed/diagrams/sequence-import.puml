@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
 BorderColor #344054
 FontColor #101828
 BackgroundColor #F9FAFB
}
title Import an event seed without losing event history - apply atomic creation or update
actor Operator as op
box "Frontend - Windows terminal" #E0F2FE
participant "ImportEventSeedCommand" as cli
end box
box "Backend - Application" #ECFDF3
participant ImportEventSeedHandler as handler
participant SeedEnvelopeReader as reader
end box
box "Backend - Infrastructure" #FFF4E5
participant SqlEventMaintenanceStore as store
database EventDbContext as db
end box
op -> cli : Apply approved seed preview
cli -> handler : Verified target, bytes and intent
handler -> store : Import [L2-055]
store -> db : Begin; lock operation; read receipt
alt Committed retry
db --> store : Saved event ID and outcome
else New operation
store -> db : Lock event; check absence or reviewed version
store -> handler : Validate merged aggregate and lifecycle
handler --> store : Valid state or conflict
alt Invalid or stale state
store -> db : Roll back
else Valid
store -> db : Save event, stages and windows
store -> db : Save operator receipt, audit and invalidation
store -> db : Commit once [L2-058]
end
end
store --> handler : Saved result or failure
handler --> cli : Outcome
cli --> op : Event ID, draft/published state and version
@enduml
