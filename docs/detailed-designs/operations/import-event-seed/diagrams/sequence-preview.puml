@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
 BorderColor #344054
 FontColor #101828
 BackgroundColor #F9FAFB
}
title Import an event seed without losing event history - validate and preview seed
actor Operator as op
box "Frontend - Windows terminal" #E0F2FE
participant "ImportEventSeedCommand" as cli
end box
box "Backend - Application" #ECFDF3
participant ImportEventSeedHandler as handler
participant SeedEnvelopeReader as reader
end box
box "Backend - Infrastructure" #FFF4E5
participant SqlEventMaintenanceStore as store
database EventDbContext as db
end box
op -> cli : events import --create or --event; --preview
cli -> reader : Read explicit UTF-8 file [L2-054]
alt Invalid bytes, keys or envelope
reader --> cli : File or field error
else Valid envelope
reader --> handler : Presence-aware data and inert metadata
handler -> store : Load update target or confirm new ID
store -> db : Read current event and schedule
db --> store : State and rowversion
store --> handler : Current state
handler -> handler : Merge; validate schedule and publication state
handler --> cli : Diff, identity, version and missing publication fields
end
cli --> op : Preview; no requested data mutation
@enduml
