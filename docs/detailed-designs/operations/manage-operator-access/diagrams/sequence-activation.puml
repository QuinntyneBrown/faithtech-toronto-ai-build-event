@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
 BorderColor #344054
 FontColor #101828
 BackgroundColor #F9FAFB
}
title Manage roster credentials and administrator access - deactivate or reactivate
actor Operator as op
box "Frontend - Windows terminal" #E0F2FE
participant "Access command" as cli
end box
box "Backend - Application" #ECFDF3
participant OperatorAccessHandler as handler
end box
box "Backend - Infrastructure" #FFF4E5
participant SqlOperatorAccessStore as store
participant "Credential or Identity services" as security
database EventDbContext as db
end box
op -> cli : Apply reviewed deactivate or reactivate
cli -> handler : IDs and expected version
handler -> store : Apply [L2-053]
store -> db : Lock event; check receipt/version
alt Deactivate
store -> db : Active=false; revoke sessions
else Reactivate with conflicting email
store -> db : Roll back without changing entry
else Valid reactivation
store -> db : Active=true; retain revoked sessions
end
opt Valid state change
store -> db : Commit changes with receipt/audit
end
store --> handler : Outcome and fresh-auth requirement
handler --> cli : Result
cli --> op : History retained; session rules reported
@enduml
