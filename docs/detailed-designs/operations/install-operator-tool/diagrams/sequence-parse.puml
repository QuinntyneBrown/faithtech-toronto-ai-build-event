@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
 BorderColor #344054
 FontColor #101828
 BackgroundColor #F9FAFB
}
title Install and update the operator tool - help and invalid syntax
actor Operator as op
box "Frontend - Windows terminal" #E0F2FE
participant Terminal as term
end box
box "Backend - Provisioning" #D1FADF
participant Program as program
participant OperatorRootCommand as root
participant CommandResultWriter as writer
end box
op -> term : faithtech-admin --help or invalid option
term -> program : Arguments
program -> root : Parse [L2-049]
alt Help or version
root --> writer : Successful informational result
else Invalid syntax
root --> writer : Usage error, exit 2
end
writer --> term : Render without opening SQL
term --> op : Output and exit code
@enduml
