@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
 BorderColor #344054
 FontColor #101828
 BackgroundColor #F9FAFB
}
title Install and update the operator tool - install or update
actor Operator as op
box "Frontend - Windows terminal" #E0F2FE
participant "PowerShell terminal" as term
end box
box "Backend - Local installation" #D1FADF
participant "Install-OperatorTool.ps1" as script
participant ".NET SDK" as sdk
database "Local package and tool registry" as files
end box
op -> term : Run installation script
term -> script : Resolve repository and SDK
script -> sdk : Restore, build and pack [L2-049]
alt Build or package failure
sdk --> script : Failure
script --> term : Nonzero; prior tool unchanged
else Package completed
sdk -> files : Write exact package version
script -> sdk : List global tools
sdk --> script : Installed or absent
script -> sdk : Install or update exact local version
sdk -> files : Register package
sdk --> script : Installed version
script --> term : Verified version or installation failure
end
term --> op : Installation result
@enduml
