@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam classBackgroundColor #F9FAFB
skinparam classBorderColor #344054
skinparam sequenceMessageAlign center
skinparam maxMessageSize 180
title Resume committed notification delivery after a crash
actor "Participant, administrator and operator" as actor
box "Frontend - Client and admin applications" #E0F2FE
participant "RecoverStatePage" as page
participant "IRecoveryService" as client
end box
box "Backend - Event API" #D1FADF
participant "RecoveryController" as controller
end box
box "Backend - Application and Domain" #ECFDF3
participant "Authorization / validation pipeline" as gate
participant "RecoverStateHandler" as handler
participant "OperationReceipt" as entity
end box
box "Backend - Infrastructure" #FFF4E5
database "SQL Server / IEventStore" as db
participant "OutboxDispatcher / EventHub" as push
end box
handler -> db : Commit state, receipt and outbox atomically [L2-044]
db --> handler : Durable commit
push -> db : Lease undispatched committed rows
db --> push : Audience and resource invalidations
alt Publish fails or worker stops
note over db : Lease expires; another worker retries.
else Publish succeeds
push -> client : SignalR invalidation via Redis fanout
push -> db : Mark dispatched
end
client -> controller : Refresh authorized resource or reconnect snapshot
controller -> gate : Revalidate session and scope
gate -> handler : Authorized read
handler -> db : Read committed authoritative state
db --> handler : Current values and versions
handler --> controller : Current projection
controller --> client : Fresh state
client --> page : Render current state; skip missed animation
@enduml
