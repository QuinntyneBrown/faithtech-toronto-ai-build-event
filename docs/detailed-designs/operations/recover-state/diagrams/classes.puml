@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam classBackgroundColor #F9FAFB
skinparam classBorderColor #344054
skinparam sequenceMessageAlign center
skinparam maxMessageSize 180
title Structure - Recover committed state after interruption
interface IRecoveryService {
  +state: Signal<RecoveryResult>
  +refresh(): Promise<void>
}
class RecoveryService {
  -http: HttpClient
  +refresh(): Promise<void>
}
class RecoverStateHandler {
  -store: IEventStore
  +Handle(request: GetOperationResultQuery): Task<RecoveryResult>
}
interface IEventStore {
  +LoadOperationReceipt(scope: ActorEventScope): Task<OperationReceipt>
  +Commit(intent: OperationContext): Task<CommitResult>
}
class OperationReceipt {
  +ActorId: Guid
  +EventId: Guid
  +OperationId: Guid
  +Target: string
  +PayloadHash: byte[]
  +ResultIdentity: Guid?
  +CommittedAtUtc: DateTimeOffset
  +Matches(payloadHash: byte[]): bool
}
RecoveryService ..|> IRecoveryService
RecoverStateHandler --> IEventStore : queries / commits through
RecoverStateHandler --> OperationReceipt : enforces policy on
class OutboxMessage {
  +Id: Guid
  +EventId: Guid
  +Audience: string
  +ResourceId: Guid
  +LeaseUntilUtc: DateTimeOffset?
  +DispatchedAtUtc: DateTimeOffset?
}
class PendingIntent {
  +OperationId: string
  +ProposedValues: object
  +State: IntentState
}
OperationReceipt ..> OutboxMessage : same committing transaction
PendingIntent ..> OperationReceipt : authorized reconciliation

@enduml
