@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers - Recover committed state after interruption
Person(actor, "Participant, administrator and operator", "recover state")
System_Boundary(system, "FaithTech event platform") {
Container(ui, "Client and admin applications", "Angular", "RecoverStatePage")
Container(api, "Event API", ".NET 10 / MediatR 12.5.0", "Reconcile unknown outcomes, resume durable work and restore authorized state")
ContainerDb(db, "Event database", "SQL Server", "All event state, operation receipts, admissions, closures and transactional outbox")
ContainerDb(redis, "Fanout backplane", "Redis; multiple API instances only", "Transient notification transport")
}
Rel(actor, ui, "Recover state")
Rel(ui, api, "Typed requests and state reads", "JSON / HTTPS")
Rel(api, db, "Commit or query scoped state", "EF Core")
Rel(api, redis, "EventHub fanout between instances")
Rel(api, ui, "Committed outbox invalidations through EventHub", "SignalR / HTTPS")

@enduml
