@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components - Recover committed state after interruption
Container(ui, "RecoverStatePage", "Angular / IRecoveryService", "Signals and typed service contract")
Container_Boundary(api, "Event API") {
Component(ctrl, "RecoveryController", "ASP.NET Core", "Bind, MediatR dispatch, return")
Component(gate, "SessionAuthorizationBehavior", "Application pipeline", "Validate actor, event and ownership")
Component(handler, "RecoverStateHandler", "Application", "Reconcile unknown outcomes, resume durable work and restore authorized state")
Component(entity, "OperationReceipt", "Domain", "All event state, operation receipts, admissions, closures and transactional outbox")
Component(store, "SqlEventStore", "Infrastructure / IEventStore", "Feature queries, concurrency and transactions")
}
ContainerDb(db, "Event database", "SQL Server", "All event state, operation receipts, admissions, closures and transactional outbox")
Rel(ui, ctrl, "Recover state", "HTTPS")
Rel(ctrl, gate, "Dispatch request through pipeline")
Rel(gate, handler, "Continue authorized request")
Rel(handler, entity, "Apply domain policy")
Rel(handler, store, "Load and persist through port")
Rel(store, db, "Query or commit", "EF Core")
@enduml
