@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
 BorderColor #344054
 FontColor #101828
 BackgroundColor #F9FAFB
}
title Review, apply and reconcile operator operations - review and apply migrations
actor Operator as op
box "Frontend - Windows terminal" #E0F2FE
participant "Operation command" as cli
end box
box "Backend - Application" #ECFDF3
participant OperatorMutationHandler as handler
end box
box "Backend - Infrastructure" #FFF4E5
participant SqlOperatorUnitOfWork as work
database "Protected previews and journal" as files
database "Verified EventDbContext" as db
end box
op -> cli : migrate --preview
cli -> handler : Migration intent
handler -> db : Read current history and pending migrations
db --> handler : Ordered IDs and current state
handler -> files : Save history and assembly fingerprint
handler --> cli : Pending migration preview
cli --> op : Explicit approval
op -> cli : Apply migration preview
cli -> handler : Approved and reverified migration intent
handler -> files : Flush Started
handler -> db : Acquire session migration lock
loop Pending migration steps
handler -> db : Apply through EF migrator
alt Committed
db --> handler : Updated migration history
handler -> files : Record completed migration ID
else Failure or cancellation
db --> handler : Failure; inspect history if reachable
break Stop on failure
handler -> handler : Retain completed IDs and uncertainty
end
end
end
handler --> cli : Completed/remaining IDs and actual outcome
cli --> op : No automatic migration replay
@enduml
