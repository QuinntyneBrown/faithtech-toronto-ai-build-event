@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
 BorderColor #344054
 FontColor #101828
 BackgroundColor #F9FAFB
}
title Review, apply and reconcile operator operations - commit validated mutation
actor Operator as op
box "Frontend - Windows terminal" #E0F2FE
participant "Operation command" as cli
end box
box "Backend - Application" #ECFDF3
participant OperatorMutationHandler as handler
end box
box "Backend - Infrastructure" #FFF4E5
participant SqlOperatorUnitOfWork as work
database "Protected previews and journal" as files
database "Verified EventDbContext" as db
end box
op -> cli : Apply approved validated intent
cli -> handler : Verified preview
handler -> files : Lock operation; flush Started [L2-059]
files --> handler : Durable attempt
handler -> work : Apply
work -> db : Begin; actor/operation locks; lookup receipt
alt Matching committed receipt
db --> work : Saved nonsecret outcome
else New intent
work -> db : Lock feature resources; compare versions
work -> work : Revalidate and apply shared mutation core
work -> db : Save data + receipt + audit + outbox
work -> db : Commit [L2-058]
db --> work : Commit confirmed or connection failure
end
work --> handler : Database outcome
handler -> files : Append terminal outcome
handler --> cli : Render text/JSON or export
alt Delivery fails after confirmed commit
cli --> op : Exit 7; reconcile without replay
else Delivered
cli --> op : Outcome and stable exit code
end
@enduml
