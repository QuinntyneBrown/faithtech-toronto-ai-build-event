@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers - Exchange private messages
Person(actor, "Participant", "exchange messages")
System_Boundary(system, "FaithTech event platform") {
Container(ui, "Client application", "Angular", "ExchangeMessagesPage")
Container(api, "Event API", ".NET 10 / MediatR 12.5.0", "Persist text-only messages for an authorized event participant pair")
ContainerDb(db, "Event database", "SQL Server", "Canonical participant pairs, immutable messages and per-conversation ordinals")
ContainerDb(redis, "Fanout backplane", "Redis; multiple API instances only", "Transient notification transport")
}
Rel(actor, ui, "Exchange messages")
Rel(ui, api, "Typed requests and state reads", "JSON / HTTPS")
Rel(api, db, "Commit or query scoped state", "EF Core")
Rel(api, redis, "EventHub fanout between instances")
Rel(api, ui, "Committed outbox invalidations through EventHub", "SignalR / HTTPS")

@enduml
