@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers - Block, report and resolve conversation abuse
Person(actor, "Participant and administrator", "moderate conversations")
System_Boundary(system, "FaithTech event platform") {
Container(ui, "Client and admin applications", "Angular", "ModerateConversationsPage")
Container(api, "Event API", ".NET 10 / MediatR 12.5.0", "Prevent new pair messages and preserve minimal report evidence")
ContainerDb(db, "Event database", "SQL Server", "Directional blocks, immutable report snapshots and administrator resolutions")
ContainerDb(redis, "Fanout backplane", "Redis; multiple API instances only", "Transient notification transport")
}
Rel(actor, ui, "Moderate conversations")
Rel(ui, api, "Typed requests and state reads", "JSON / HTTPS")
Rel(api, db, "Commit or query scoped state", "EF Core")
Rel(api, redis, "EventHub fanout between instances")
Rel(api, ui, "Committed outbox invalidations through EventHub", "SignalR / HTTPS")

@enduml
