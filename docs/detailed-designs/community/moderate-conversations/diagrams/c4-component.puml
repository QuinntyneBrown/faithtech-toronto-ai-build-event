@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components - Block, report and resolve conversation abuse
Container(ui, "ModerateConversationsPage", "Angular / IModerationService", "Signals and typed service contract")
Container_Boundary(api, "Event API") {
Component(ctrl, "ModerationController", "ASP.NET Core", "Bind, MediatR dispatch, return")
Component(gate, "SessionAuthorizationBehavior", "Application pipeline", "Validate actor, event and ownership")
Component(handler, "ModerateConversationsHandler", "Application", "Prevent new pair messages and preserve minimal report evidence")
Component(entity, "MessageReport", "Domain", "Directional blocks, immutable report snapshots and administrator resolutions")
Component(store, "SqlEventStore", "Infrastructure / IEventStore", "Feature queries, concurrency and transactions")
}
ContainerDb(db, "Event database", "SQL Server", "Directional blocks, immutable report snapshots and administrator resolutions")
Rel(ui, ctrl, "Moderate conversations", "HTTPS")
Rel(ctrl, gate, "Dispatch request through pipeline")
Rel(gate, handler, "Continue authorized request")
Rel(handler, entity, "Apply domain policy")
Rel(handler, store, "Load and persist through port")
Rel(store, db, "Query or commit", "EF Core")
@enduml
