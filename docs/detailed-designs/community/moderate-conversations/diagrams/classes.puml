@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam classBackgroundColor #F9FAFB
skinparam classBorderColor #344054
skinparam sequenceMessageAlign center
skinparam maxMessageSize 180
title Structure - Block, report and resolve conversation abuse
interface IModerationService {
  +state: Signal<ReportDetail>
  +refresh(): Promise<void>
}
class ModerationService {
  -http: HttpClient
  +refresh(): Promise<void>
}
class ModerateConversationsHandler {
  -store: IEventStore
  +Handle(request: ResolveReportCommand): Task<ReportDetail>
}
interface IEventStore {
  +LoadMessageReport(scope: ActorEventScope): Task<MessageReport>
  +Commit(intent: OperationContext): Task<CommitResult>
}
class MessageReport {
  +Id: Guid
  +EventId: Guid
  +ReporterId: Guid
  +MessageId: Guid
  +ReportedText: string
  +Reason: string?
  +Status: ReportStatus
  +Resolve(outcome: ResolutionOutcome, actor: Guid, now: DateTimeOffset, note: string?): void
}
ModerationService ..|> IModerationService
ModerateConversationsHandler --> IEventStore : queries / commits through
ModerateConversationsHandler --> MessageReport : enforces policy on
class ParticipantBlock {
  +EventId: Guid
  +BlockingParticipantId: Guid
  +BlockedParticipantId: Guid
}
class ReportResolution {
  +Outcome: ResolutionOutcome
  +AdministratorId: Guid
  +ResolvedAtUtc: DateTimeOffset
  +Note: string?
}
class ReportedMessageSnapshot {
  +SenderId: Guid
  +RecipientId: Guid
  +SentAtUtc: DateTimeOffset
  +Body: string
}
MessageReport "1" *-- "1" ReportedMessageSnapshot
MessageReport "1" *-- "0..1" ReportResolution
ParticipantBlock ..> MessageReport : independent safety actions

@enduml
