@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components - Share a participant profile
Container(ui, "ShareProfilePage", "Angular / IProfileService", "Signals and typed service contract")
Container_Boundary(api, "Event API") {
Component(ctrl, "ProfileController", "ASP.NET Core", "Bind, MediatR dispatch, return")
Component(gate, "SessionAuthorizationBehavior", "Application pipeline", "Validate actor, event and ownership")
Component(handler, "ShareProfileHandler", "Application", "Save optional profile content and explicitly control discovery visibility")
Component(entity, "ParticipantProfile", "Domain", "Owner profiles, sharing flags and normalized tags")
Component(store, "SqlEventStore", "Infrastructure / IEventStore", "Feature queries, concurrency and transactions")
}
ContainerDb(db, "Event database", "SQL Server", "Owner profiles, sharing flags and normalized tags")
Rel(ui, ctrl, "Share profile", "HTTPS")
Rel(ctrl, gate, "Dispatch request through pipeline")
Rel(gate, handler, "Continue authorized request")
Rel(handler, entity, "Apply domain policy")
Rel(handler, store, "Load and persist through port")
Rel(store, db, "Query or commit", "EF Core")
@enduml
