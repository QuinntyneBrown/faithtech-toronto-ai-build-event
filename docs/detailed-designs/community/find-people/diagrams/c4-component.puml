@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components - Find people and explain matches
Container(ui, "FindPeoplePage", "Angular / IDirectoryService", "Signals and typed service contract")
Container_Boundary(api, "Event API") {
Component(ctrl, "DirectoryController", "ASP.NET Core", "Bind, MediatR dispatch, return")
Component(gate, "SessionAuthorizationBehavior", "Application pipeline", "Validate actor, event and ownership")
Component(handler, "FindPeopleHandler", "Application", "Search active roster names and rank actual shared tag intersections")
Component(entity, "DirectoryEntry", "Domain", "Active registrations, shared profile projections and block exclusions")
Component(store, "SqlEventStore", "Infrastructure / IEventStore", "Feature queries, concurrency and transactions")
}
ContainerDb(db, "Event database", "SQL Server", "Active registrations, shared profile projections and block exclusions")
Rel(ui, ctrl, "Find people", "HTTPS")
Rel(ctrl, gate, "Dispatch request through pipeline")
Rel(gate, handler, "Continue authorized request")
Rel(handler, entity, "Apply domain policy")
Rel(handler, store, "Load and persist through port")
Rel(store, db, "Query or commit", "EF Core")
@enduml
