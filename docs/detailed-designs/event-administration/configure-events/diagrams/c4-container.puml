@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers - Configure events
Person(actor, "Administrator", "configure events")
System_Boundary(system, "FaithTech event platform") {
Container(ui, "Admin application", "Angular", "ConfigureEventsPage")
Container(api, "Event API", ".NET 10 / MediatR 12.5.0", "Save drafts, publish validated configuration, copy configuration only")
ContainerDb(db, "Event database", "SQL Server", "Events, content, validated logo assets and configuration versions")
ContainerDb(redis, "Fanout backplane", "Redis; multiple API instances only", "Transient notification transport")
}
Rel(actor, ui, "Configure events")
Rel(ui, api, "Typed requests and state reads", "JSON / HTTPS")
Rel(api, db, "Commit or query scoped state", "EF Core")
Rel(api, redis, "EventHub fanout between instances")
Rel(api, ui, "Committed outbox invalidations through EventHub", "SignalR / HTTPS")
@enduml
