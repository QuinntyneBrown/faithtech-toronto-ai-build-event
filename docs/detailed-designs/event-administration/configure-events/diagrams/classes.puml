@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam classBackgroundColor #F9FAFB
skinparam classBorderColor #344054
skinparam sequenceMessageAlign center
skinparam maxMessageSize 180
title Structure - Configure events
interface IEventService {
  +state: Signal<EventDetail>
  +refresh(): Promise<void>
}
class EventService {
  -http: HttpClient
  +refresh(): Promise<void>
}
class ConfigureEventsHandler {
  -store: IEventStore
  +Handle(request: SaveEventCommand): Task<EventDetail>
}
interface IEventStore {
  +LoadEvent(scope: ActorEventScope): Task<Event>
  +Commit(intent: OperationContext): Task<CommitResult>
}
class Event {
  +Id: Guid
  +Title: string?
  +Timezone: string?
  +StartsAtUtc: DateTimeOffset?
  +EndsAtUtc: DateTimeOffset?
  +VenueName: string?
  +Latitude: double?
  +Longitude: double?
  +LogoId: Guid?
  +PublishedAtUtc: DateTimeOffset?
  +SaveDraft(input: EventInput): ValidationResult
  +Publish(now: DateTimeOffset): ValidationResult
}
EventService ..|> IEventService
ConfigureEventsHandler --> IEventStore : queries / commits through
ConfigureEventsHandler --> Event : enforces policy on
class EventContent {
  +WaitingText: string?
  +ClosingText: string?
  +DirectionsUrl: Uri?
}
class LogoAsset {
  +Id: Guid
  +MediaType: string
  +Bytes: byte[]
  +Width: int
  +Height: int
}
Event "1" *-- "1" EventContent
Event "0..*" --> "0..1" LogoAsset : validated branding

@enduml
