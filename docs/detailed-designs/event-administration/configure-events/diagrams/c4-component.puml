@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components - Configure events
Container(ui, "ConfigureEventsPage", "Angular / IEventService", "Signals and typed service contract")
Container_Boundary(api, "Event API") {
Component(ctrl, "EventController", "ASP.NET Core", "Bind, MediatR dispatch, return")
Component(gate, "SessionAuthorizationBehavior", "Application pipeline", "Validate actor, event and ownership")
Component(handler, "ConfigureEventsHandler", "Application", "Save drafts, publish validated configuration, copy configuration only")
Component(entity, "Event", "Domain", "Events, content, validated logo assets and configuration versions")
Component(store, "SqlEventStore", "Infrastructure / IEventStore", "Feature queries, concurrency and transactions")
}
ContainerDb(db, "Event database", "SQL Server", "Events, content, validated logo assets and configuration versions")
Rel(ui, ctrl, "Configure events", "HTTPS")
Rel(ctrl, gate, "Dispatch request through pipeline")
Rel(gate, handler, "Continue authorized request")
Rel(handler, entity, "Apply domain policy")
Rel(handler, store, "Load and persist through port")
Rel(store, db, "Query or commit", "EF Core")
@enduml
