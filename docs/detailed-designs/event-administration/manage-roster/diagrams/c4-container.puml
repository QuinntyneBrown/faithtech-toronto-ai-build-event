@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers - Manage the event roster
Person(actor, "Administrator", "manage roster")
System_Boundary(system, "FaithTech event platform") {
Container(ui, "Admin application", "Angular", "ManageRosterPage")
Container(api, "Event API", ".NET 10 / MediatR 12.5.0", "Maintain stable identities and revoke credentials without deleting history")
ContainerDb(db, "Event database", "SQL Server", "Registrations, code digests, email bindings and session revocations")
ContainerDb(redis, "Fanout backplane", "Redis; multiple API instances only", "Transient notification transport")
}
Rel(actor, ui, "Manage roster")
Rel(ui, api, "Typed requests and state reads", "JSON / HTTPS")
Rel(api, db, "Commit or query scoped state", "EF Core")
Rel(api, redis, "EventHub fanout between instances")
Rel(api, ui, "Committed outbox invalidations through EventHub", "SignalR / HTTPS")
@enduml
