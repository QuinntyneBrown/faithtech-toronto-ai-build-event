@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Support responsive and accessible interaction — components
Container(client, "AppComponent", "Companion Angular client", "Presents this capability")
Container_Boundary(api, "Companion API") {
Component(entry, "EventStateController", "ASP.NET Core controller", "Binds inputs and dispatches")
Component(handler, "GetEventSnapshotHandler", "Application handler", "Keep all four screens usable across viewport and capability changes")
Component(entity, "PresentationState", "Domain model", "Owns slice state")
}
ContainerDb(db, "Companion database", "SQL Server", "Durable state")
Rel(client, entry, "Calls through IEventService")
Rel(entry, handler, "Dispatches")
Rel(handler, entity, "Uses")
Rel(handler, db, "Commits through application persistence contract")
@enduml
