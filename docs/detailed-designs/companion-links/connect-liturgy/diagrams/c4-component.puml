@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components - Expose optional Liturgy links
Container(ui, "ConnectLiturgyPage", "Angular / ICompanionService", "Signals and typed service contract")
Container_Boundary(api, "Event API") {
Component(ctrl, "CompanionController", "ASP.NET Core", "Bind, MediatR dispatch, return")
Component(gate, "SessionAuthorizationBehavior", "Application pipeline", "Validate actor, event and ownership")
Component(handler, "ConnectLiturgyHandler", "Application", "Conditionally expose external project links without integration or lifecycle gates")
Component(entity, "CompanionSettings", "Domain", "Per-event opt-in flags and retained optional project URLs")
Component(store, "SqlEventStore", "Infrastructure / IEventStore", "Feature queries, concurrency and transactions")
}
ContainerDb(db, "Event database", "SQL Server", "Per-event opt-in flags and retained optional project URLs")
Rel(ui, ctrl, "Connect liturgy", "HTTPS")
Rel(ctrl, gate, "Dispatch request through pipeline")
Rel(gate, handler, "Continue authorized request")
Rel(handler, entity, "Apply domain policy")
Rel(handler, store, "Load and persist through port")
Rel(store, db, "Query or commit", "EF Core")
@enduml
