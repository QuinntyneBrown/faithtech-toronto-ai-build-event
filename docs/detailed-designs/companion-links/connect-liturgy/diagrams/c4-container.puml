@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers - Expose optional Liturgy links
Person(actor, "Participant and administrator", "connect liturgy")
System_Boundary(system, "FaithTech event platform") {
Container(ui, "Client and admin applications", "Angular", "ConnectLiturgyPage")
Container(api, "Event API", ".NET 10 / MediatR 12.5.0", "Conditionally expose external project links without integration or lifecycle gates")
ContainerDb(db, "Event database", "SQL Server", "Per-event opt-in flags and retained optional project URLs")
ContainerDb(redis, "Fanout backplane", "Redis; multiple API instances only", "Transient notification transport")
}
Rel(actor, ui, "Connect liturgy")
Rel(ui, api, "Typed requests and state reads", "JSON / HTTPS")
Rel(api, db, "Commit or query scoped state", "EF Core")
Rel(api, redis, "EventHub fanout between instances")
Rel(api, ui, "Committed outbox invalidations through EventHub", "SignalR / HTTPS")
System_Ext(liturgy, "Liturgy", "No API or shared authentication")
Rel(ui, liturgy, "Browser navigation only when enabled", "HTTPS link")
@enduml
