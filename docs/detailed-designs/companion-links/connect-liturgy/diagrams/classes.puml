interface ICompanionService {
  +state: Signal<CompanionSettingsView>
  +refresh(): Promise<void>
}
class CompanionService {
  -http: HttpClient
  +refresh(): Promise<void>
}
class ConnectLiturgyHandler {
  -store: IEventStore
  +Handle(request: SetCompanionEnabledCommand): Task<CompanionSettingsView>
}
interface IEventStore {
  +LoadAuthorized(scope: ActorEventScope): Task<CompanionSettings>
  +Commit(intent: OperationContext): Task<CommitResult>
}
class CompanionSettings {
  +EventId: Guid
  +UseLiturgy: bool
  +SetEnabled(enabled: bool): void
}
CompanionService ..|> ICompanionService
ConnectLiturgyHandler --> IEventStore : queries / commits through
ConnectLiturgyHandler --> CompanionSettings : enforces policy on
class ProjectCompanionLink {
  +EventId: Guid
  +ProjectId: Guid
  +Url: Uri?
}
class CompanionAction {
  +Label: string
  +Url: Uri
}
CompanionSettings "1" --> "0..*" ProjectCompanionLink
CompanionSettings ..> CompanionAction : projects only when enabled and valid

