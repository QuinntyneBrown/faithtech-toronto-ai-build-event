@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam classBackgroundColor #F9FAFB
skinparam classBorderColor #344054
skinparam sequenceMessageAlign center
skinparam maxMessageSize 180
title Project a conditional external action
actor "Participant and administrator" as actor
box "Frontend - Client and admin applications" #E0F2FE
participant "ConnectLiturgyPage" as page
participant "ICompanionService" as client
end box
box "Backend - Event API" #D1FADF
participant "CompanionController" as controller
end box
box "Backend - Application and Domain" #ECFDF3
participant "Authorization / validation pipeline" as gate
participant "ConnectLiturgyHandler" as handler
participant "CompanionSettings" as entity
end box
box "Backend - Infrastructure" #FFF4E5
database "SQL Server / IEventStore" as db
participant "OutboxDispatcher / EventHub" as push
end box
actor -> page : Open project selection, detail or recap
page -> client : Load project projection
client -> controller : Authorized HTTPS query
controller -> gate : MediatR dispatch
gate -> handler : Authorized query
handler -> db : Read event flag and project URL
db --> handler : Retained configuration
alt Enabled and valid URL [L2-027]
handler --> controller : Include CompanionAction
controller --> client : Authorized project projection
client --> page : Render ordinary external anchor
actor -> page : Follow action
note over page
Browser navigates to Liturgy.
Independent access; no API integration [L2-028].
end note
else Disabled or absent URL [L2-026]
handler --> controller : Omit action and URL
controller --> client : Core project projection
client --> page : Render core event content
end
@enduml
