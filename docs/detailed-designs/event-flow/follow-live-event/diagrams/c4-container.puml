@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers - Follow the live event
Person(actor, "Participant", "follow live event")
System_Boundary(system, "FaithTech event platform") {
Container(ui, "Client application", "Angular", "FollowLiveEventPage")
Container(api, "Event API", ".NET 10 / MediatR 12.5.0", "Display authoritative countdowns, stages and recap without losing activity drafts")
ContainerDb(db, "Event database", "SQL Server", "Event timing, stage content, venue branding and authorized snapshot projections")
ContainerDb(redis, "Fanout backplane", "Redis; multiple API instances only", "Transient notification transport")
}
Rel(actor, ui, "Follow live event")
Rel(ui, api, "Typed requests and state reads", "JSON / HTTPS")
Rel(api, db, "Commit or query scoped state", "EF Core")
Rel(api, redis, "EventHub fanout between instances")
Rel(api, ui, "Committed outbox invalidations through EventHub", "SignalR / HTTPS")
System_Ext(maps, "Configured tile provider", "Optional external tiles")
Rel(ui, maps, "Render venue marker; text remains on failure", "HTTPS")
@enduml
