@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam classBackgroundColor #F9FAFB
skinparam classBorderColor #344054
skinparam sequenceMessageAlign center
skinparam maxMessageSize 180
title Transition or resume without losing an activity draft
actor "Participant" as actor
box "Frontend - Client application" #E0F2FE
participant "FollowLiveEventPage" as page
participant "ILiveEventService" as client
end box
box "Backend - Event API" #D1FADF
participant "LiveEventController" as controller
end box
box "Backend - Application and Domain" #ECFDF3
participant "Authorization / validation pipeline" as gate
participant "FollowLiveEventHandler" as handler
participant "EventSnapshot" as entity
end box
box "Backend - Infrastructure" #FFF4E5
database "SQL Server / IEventStore" as db
participant "OutboxDispatcher / EventHub" as push
end box
push -> client : Committed invalidation or boundary signal [L2-007]
client -> controller : GetEventSnapshotQuery; validate session first on resume
controller -> gate : MediatR dispatch
gate -> handler : Authorized query
handler -> db : Read current configuration and server time
db --> handler : Current snapshot data
handler --> controller : EventSnapshot
controller --> client : Authoritative response
alt Failed or pending synchronization
client --> page : Explicit unavailable / reconnecting state
else Main event route
client --> page : Replace scheduled panel within two seconds
page -> page : Focus heading only if prior focus was removed [L2-036]
else Another core activity
client --> page : Preserve activity and draft; announce current stage
page --> actor : Current-event navigation action
end
opt Restored tab
page -> page : Skip missed transitions and animations [L2-007]
end
@enduml
