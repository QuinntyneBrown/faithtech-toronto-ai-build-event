@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam classBackgroundColor #F9FAFB
skinparam classBorderColor #344054
skinparam sequenceMessageAlign center
skinparam maxMessageSize 180
title Structure - Follow the live event
interface ILiveEventService {
  +state: Signal<EventSnapshot>
  +refresh(): Promise<void>
}
class LiveEventService {
  -http: HttpClient
  +refresh(): Promise<void>
}
class FollowLiveEventHandler {
  -store: IEventStore
  +Handle(request: GetEventSnapshotQuery): Task<EventSnapshot>
}
interface IEventStore {
  +LoadEventSnapshot(scope: ActorEventScope): Task<EventSnapshot>
  +Commit(intent: OperationContext): Task<CommitResult>
}
class EventSnapshot {
  +EventId: Guid
  +ServerNowUtc: DateTimeOffset
  +StartsAtUtc: DateTimeOffset
  +EndsAtUtc: DateTimeOffset
  +CurrentStageId: Guid?
  +Mode: EventScreenMode
  +NextBoundaryUtc: DateTimeOffset?
  +ResolveAt(now: DateTimeOffset): EventScreenMode
}
LiveEventService ..|> ILiveEventService
FollowLiveEventHandler --> IEventStore : queries / commits through
FollowLiveEventHandler --> EventSnapshot : enforces policy on
class StageView {
  +Id: Guid
  +ScreenType: string
  +Heading: string
  +Content: string
}
class VenueView {
  +Name: string
  +Address: string?
  +Latitude: double
  +Longitude: double
  +DirectionsUrl: Uri?
  +LogoUrl: Uri
}
EventSnapshot "1" --> "0..1" StageView
EventSnapshot "1" --> "1" VenueView

@enduml
