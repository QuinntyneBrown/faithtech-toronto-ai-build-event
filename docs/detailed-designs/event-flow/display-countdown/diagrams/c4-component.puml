@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Display countdown, welcome, and event information — components
Container(client, "CountdownPageComponent", "Companion Angular client", "Presents this capability")
Container_Boundary(api, "Companion API") {
Component(entry, "EventStateController", "ASP.NET Core controller", "Binds inputs and dispatches")
Component(handler, "GetEventSnapshotHandler", "Application handler", "Show synchronized remaining time without scheduling transitions")
Component(entity, "EventConfiguration", "Domain model", "Owns slice state")
}
ContainerDb(db, "Companion database", "SQL Server", "Durable state")
Rel(client, entry, "Calls through IEventService")
Rel(entry, handler, "Dispatches")
Rel(handler, entity, "Uses")
Rel(handler, db, "Reads through application persistence contract")
@enduml
