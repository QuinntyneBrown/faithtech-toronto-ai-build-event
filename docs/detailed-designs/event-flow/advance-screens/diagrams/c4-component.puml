@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Advance the four screens under presenter control — components
Container(client, "AppComponent", "Companion Angular client", "Presents this capability")
Container_Boundary(api, "Companion API") {
Component(entry, "EventFlowController", "ASP.NET Core controller", "Binds inputs and dispatches")
Component(handler, "AdvanceScreenHandler", "Application handler", "Persist one deliberate stage transition without skipping screens")
Component(entity, "EventState", "Domain model", "Owns slice state")
}
ContainerDb(db, "Companion database", "SQL Server", "Durable state")
Rel(client, entry, "Calls through IEventService")
Rel(entry, handler, "Dispatches")
Rel(handler, entity, "Uses")
Rel(handler, db, "Commits through application persistence contract")
@enduml
