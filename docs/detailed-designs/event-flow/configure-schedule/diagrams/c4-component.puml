@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components - Configure the event schedule
Container(ui, "ConfigureSchedulePage", "Angular / IScheduleService", "Signals and typed service contract")
Container_Boundary(api, "Event API") {
Component(ctrl, "ScheduleController", "ASP.NET Core", "Bind, MediatR dispatch, return")
Component(gate, "SessionAuthorizationBehavior", "Application pipeline", "Validate actor, event and ownership")
Component(handler, "ConfigureScheduleHandler", "Application", "Resolve dated intervals and preserve irreversible activity closure")
Component(entity, "EventSchedule", "Domain", "Event intervals, stages, activity windows and durable closure records")
Component(store, "SqlEventStore", "Infrastructure / IEventStore", "Feature queries, concurrency and transactions")
}
ContainerDb(db, "Event database", "SQL Server", "Event intervals, stages, activity windows and durable closure records")
Rel(ui, ctrl, "Configure schedule", "HTTPS")
Rel(ctrl, gate, "Dispatch request through pipeline")
Rel(gate, handler, "Continue authorized request")
Rel(handler, entity, "Apply domain policy")
Rel(handler, store, "Load and persist through port")
Rel(store, db, "Query or commit", "EF Core")
@enduml
