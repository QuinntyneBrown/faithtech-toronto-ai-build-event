@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers - Configure the event schedule
Person(actor, "Administrator", "configure schedule")
System_Boundary(system, "FaithTech event platform") {
Container(ui, "Admin application", "Angular", "ConfigureSchedulePage")
Container(api, "Event API", ".NET 10 / MediatR 12.5.0", "Resolve dated intervals and preserve irreversible activity closure")
ContainerDb(db, "Event database", "SQL Server", "Event intervals, stages, activity windows and durable closure records")
ContainerDb(redis, "Fanout backplane", "Redis; multiple API instances only", "Transient notification transport")
}
Rel(actor, ui, "Configure schedule")
Rel(ui, api, "Typed requests and state reads", "JSON / HTTPS")
Rel(api, db, "Commit or query scoped state", "EF Core")
Rel(api, redis, "EventHub fanout between instances")
Rel(api, ui, "Committed outbox invalidations through EventHub", "SignalR / HTTPS")
@enduml
