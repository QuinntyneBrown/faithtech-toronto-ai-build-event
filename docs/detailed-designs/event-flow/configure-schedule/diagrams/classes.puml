@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam classBackgroundColor #F9FAFB
skinparam classBorderColor #344054
skinparam sequenceMessageAlign center
skinparam maxMessageSize 180
title Structure - Configure the event schedule
interface IScheduleService {
  +state: Signal<ScheduleDetail>
  +refresh(): Promise<void>
}
class ScheduleService {
  -http: HttpClient
  +refresh(): Promise<void>
}
class ConfigureScheduleHandler {
  -store: IEventStore
  +Handle(request: SaveScheduleCommand): Task<ScheduleDetail>
}
interface IEventStore {
  +LoadAuthorized(scope: ActorEventScope): Task<EventSchedule>
  +Commit(intent: OperationContext): Task<CommitResult>
}
class EventSchedule {
  +EventId: Guid
  +Timezone: string
  +StartsAtUtc: DateTimeOffset
  +EndsAtUtc: DateTimeOffset
  +SelectionWindow: TimeWindow?
  +PresentationWindow: TimeWindow?
  +Validate(entries: Stage[]): ValidationResult
  +ResolveCurrent(now: DateTimeOffset): Stage?
  +ApplyEdit(input: ScheduleInput, now: DateTimeOffset): ValidationResult
}
ScheduleService ..|> IScheduleService
ConfigureScheduleHandler --> IEventStore : queries / commits through
ConfigureScheduleHandler --> EventSchedule : enforces policy on
class Stage {
  +Id: Guid
  +ScreenType: string
  +Content: string
  +StartsAtUtc: DateTimeOffset
  +EndsAtUtc: DateTimeOffset
  +QuizId: Guid?
}
class WindowClosure {
  +WindowId: Guid
  +EffectiveAtUtc: DateTimeOffset
  +Reason: string
}
class TimeWindow {
  +StartsAtUtc: DateTimeOffset
  +EndsAtUtc: DateTimeOffset
}
EventSchedule "1" *-- "0..*" Stage
EventSchedule "1" *-- "0..2" TimeWindow
EventSchedule "1" --> "0..*" WindowClosure

@enduml
