@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Administer participants on Countdown — components
Container(client, "ParticipantManagerComponent", "Companion Angular client", "Presents this capability")
Container_Boundary(api, "Companion API") {
Component(entry, "RosterController", "ASP.NET Core controller", "Binds inputs and dispatches")
Component(handler, "SaveParticipantHandler", "Application handler", "Correct roster records and remove private data coherently")
Component(entity, "Participant", "Domain model", "Owns slice state")
}
ContainerDb(db, "Companion database", "SQL Server", "Durable state")
Rel(client, entry, "Calls through IRosterService")
Rel(entry, handler, "Dispatches")
Rel(handler, entity, "Uses")
Rel(handler, db, "Commits through application persistence contract")
@enduml
