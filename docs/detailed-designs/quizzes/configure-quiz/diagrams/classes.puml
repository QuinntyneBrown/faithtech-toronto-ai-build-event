@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam classBackgroundColor #F9FAFB
skinparam classBorderColor #344054
skinparam sequenceMessageAlign center
skinparam maxMessageSize 180
title Structure - Configure a quiz lifecycle
interface IQuizService {
  +state: Signal<QuizDefinition>
  +refresh(): Promise<void>
}
class QuizService {
  -http: HttpClient
  +refresh(): Promise<void>
}
class ConfigureQuizHandler {
  -store: IEventStore
  +Handle(request: SaveQuizCommand): Task<QuizDefinition>
}
interface IEventStore {
  +LoadAuthorized(scope: ActorEventScope): Task<Quiz>
  +Commit(intent: OperationContext): Task<CommitResult>
}
class Quiz {
  +Id: Guid
  +EventId: Guid
  +Title: string?
  +Activated: bool
  +OpensAtUtc: DateTimeOffset?
  +ClosesAtUtc: DateTimeOffset?
  +Activate(now: DateTimeOffset): ValidationResult
  +Edit(input: QuizInput, now: DateTimeOffset): ValidationResult
}
QuizService ..|> IQuizService
ConfigureQuizHandler --> IEventStore : queries / commits through
ConfigureQuizHandler --> Quiz : enforces policy on
class QuizQuestion {
  +Id: Guid
  +Position: int
  +Text: string?
  +CorrectOptionId: Guid?
}
class QuizOption {
  +Id: Guid
  +Position: int
  +Text: string?
}
class WindowClosure {
  +WindowId: Guid
  +EffectiveAtUtc: DateTimeOffset
}
Quiz "1" *-- "0..*" QuizQuestion
QuizQuestion "1" *-- "0..6" QuizOption
Quiz "1" --> "0..1" WindowClosure

@enduml
