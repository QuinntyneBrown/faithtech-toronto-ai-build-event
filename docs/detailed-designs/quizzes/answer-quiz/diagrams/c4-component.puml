@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components - Answer a quiz and read final results
Container(ui, "AnswerQuizPage", "Angular / IQuizService", "Signals and typed service contract")
Container_Boundary(api, "Event API") {
Component(ctrl, "QuizController", "ASP.NET Core", "Bind, MediatR dispatch, return")
Component(gate, "SessionAuthorizationBehavior", "Application pipeline", "Validate actor, event and ownership")
Component(handler, "AnswerQuizHandler", "Application", "Admit one immutable answer per question and disclose scores only after closure")
Component(entity, "QuizAnswer", "Domain", "Durable answer admissions, immutable submissions and finalized per-quiz results")
Component(store, "SqlEventStore", "Infrastructure / IEventStore", "Feature queries, concurrency and transactions")
}
ContainerDb(db, "Event database", "SQL Server", "Durable answer admissions, immutable submissions and finalized per-quiz results")
Rel(ui, ctrl, "Answer quiz", "HTTPS")
Rel(ctrl, gate, "Dispatch request through pipeline")
Rel(gate, handler, "Continue authorized request")
Rel(handler, entity, "Apply domain policy")
Rel(handler, store, "Load and persist through port")
Rel(store, db, "Query or commit", "EF Core")
@enduml
