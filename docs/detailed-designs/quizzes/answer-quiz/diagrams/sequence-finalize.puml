@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam classBackgroundColor #F9FAFB
skinparam classBorderColor #344054
skinparam sequenceMessageAlign center
skinparam maxMessageSize 180
title Close admissions and publish stable quiz results
box "Backend - Application and Domain" #ECFDF3
participant "Quiz closure coordinator" as closer
participant "AnswerQuizHandler" as handler
end box
box "Backend - Infrastructure" #FFF4E5
database "SQL admission fence and rows" as db
participant "QuizAdmissionRecoveryWorker" as worker
participant "OutboxDispatcher / EventHub" as push
end box
box "Frontend - Client application" #E0F2FE
participant "IQuizService / AnswerQuizPage" as page
end box
closer -> db : Acquire exclusive fence at closing boundary [L2-018/019]
db --> closer : Ordered set of all pre-close durable admissions
closer -> db : Commit permanent closure; reject later admissions
loop Each unresolved pre-close admission
worker -> handler : Resolve authorized admitted intent with original receipt time
handler -> db : Insert unique answer or retain original conflicting choice
db --> handler : Durable resolution and receipt
end
alt All earlier admissions resolved
closer -> db : Commit final scores against frozen questions and keys
db --> closer : Immutable quiz results and invalidation
push -> page : Results available; refetch authorized projection
page -> page : Render personal outcomes and 1,1,3 ranking [L2-019]
else Dependency failure or pending work
closer --> page : Finalizing / unavailable; no provisional score
note over worker : Resume durable admissions after recovery.
end
@enduml
