@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers - Answer a quiz and read final results
Person(actor, "Participant", "answer quiz")
System_Boundary(system, "FaithTech event platform") {
Container(ui, "Client application", "Angular", "AnswerQuizPage")
Container(api, "Event API", ".NET 10 / MediatR 12.5.0", "Admit one immutable answer per question and disclose scores only after closure")
ContainerDb(db, "Event database", "SQL Server", "Durable answer admissions, immutable submissions and finalized per-quiz results")
ContainerDb(redis, "Fanout backplane", "Redis; multiple API instances only", "Transient notification transport")
}
Rel(actor, ui, "Answer quiz")
Rel(ui, api, "Typed requests and state reads", "JSON / HTTPS")
Rel(api, db, "Commit or query scoped state", "EF Core")
Rel(api, redis, "EventHub fanout between instances")
Rel(api, ui, "Committed outbox invalidations through EventHub", "SignalR / HTTPS")

@enduml
