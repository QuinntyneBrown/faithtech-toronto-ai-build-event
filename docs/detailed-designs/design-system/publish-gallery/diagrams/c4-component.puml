@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components - Publish the standalone design gallery
Container_Boundary(site, "Standalone gallery") {
Component(html, "index.html", "HTML", "Light document and native dialog")
Component(gallery, "gallery.js", "JavaScript module", "Swatches and trusted specimen markup")
Component(patterns, "gallery-patterns.js", "JavaScript module", "Additional fixed specimens")
Component(css, "tokens.css / theme.css / patterns.css", "CSS", "Authoritative roles and primitive treatments")
Rel(html, gallery, "Loads module")
Rel(gallery, patterns, "Imports patterns")
Rel(html, css, "Loads styles")
Rel(gallery, css, "Reads computed token values")
}
@enduml
