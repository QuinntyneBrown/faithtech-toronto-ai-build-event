@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam classBackgroundColor #F9FAFB
skinparam classBorderColor #344054
skinparam sequenceMessageAlign center
skinparam maxMessageSize 180
title Build and open the independent gallery
actor "Developer" as actor
box "Build tooling - Standalone design system" #FFF4E5
participant "scripts/build.mjs" as build
collections "Local sources / dist/site" as files
end box
box "Frontend - Standalone gallery" #E0F2FE
participant "index.html / gallery.js" as gallery
participant "Native dialog" as dialog
end box
actor -> build : npm run build [L2-029]
build -> files : Copy explicit HTML/CSS/JS/assets/license inputs
files --> build : Independent static artifact
build --> actor : Build destination
actor -> gallery : Open deployed gallery
gallery -> files : Load local styles and specimen modules
files --> gallery : Authoritative --cs-* roles [L2-030]
actor -> gallery : Select Open dialog
gallery -> dialog : showModal()
dialog --> actor : Focused native dialog
alt Asset unavailable
gallery --> actor : Browser load failure visible to verification
else All assets available
gallery --> actor : Inspect local specimen states
end
@enduml
