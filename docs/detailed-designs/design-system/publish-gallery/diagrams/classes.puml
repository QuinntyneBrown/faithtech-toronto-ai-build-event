@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam classBackgroundColor #F9FAFB
skinparam classBorderColor #344054
skinparam sequenceMessageAlign center
skinparam maxMessageSize 180
title Structure - Publish the standalone design gallery
class "gallery.js" as Gallery <<module>> {
  +root: HTMLElement
  +computedSwatch(role: string): string
}
class "gallery-patterns.js" as Patterns <<module>> {
  +patterns: string
}
class "tokens.css" as Tokens <<artifact>> {
  +prefix: --cs-
  +roles: CSSCustomProperty[]
}
class ComponentGalleryPage {
  +page: Page
  +open(): Promise<void>
  +openDialog(): Promise<void>
  +specimen(css: string): Promise<void>
  +styles(): Promise<StyleValues[]>
}
Gallery --> Patterns : appends trusted specimens
Gallery --> Tokens : reads computed values
ComponentGalleryPage ..> Gallery : exercises

@enduml
