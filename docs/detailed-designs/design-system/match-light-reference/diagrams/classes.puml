@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam classBackgroundColor #F9FAFB
skinparam classBorderColor #344054
skinparam sequenceMessageAlign center
skinparam maxMessageSize 180
title Structure - Match the recorded Cornerstone light reference
class ComponentGalleryPage {
  +specimen(css: string): Promise<void>
  +styles(): Promise<StyleValues[]>
}
class "cornerstone-light.css" as Reference <<artifact>> {
  +normalizedSha256: string
}
class "tokens.css + theme.css + patterns.css" as Local <<artifact>> {
  +prefix: --cs-
  +colourScheme: light
}
class "reference-manifest.json" as Manifest <<evidence>> {
  +revision: string
  +files: SourceEvidence[]
}
ComponentGalleryPage ..> Reference : matching specimen
ComponentGalleryPage ..> Local : matching specimen
Manifest --> Reference : identifies retained content

@enduml
