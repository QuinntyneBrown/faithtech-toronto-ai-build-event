@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Move team members and assign projects — components
Container(client, "TeamsPageComponent", "Companion Angular client", "Presents this capability")
Container_Boundary(api, "Companion API") {
Component(entry, "TeamsController", "ASP.NET Core controller", "Binds inputs and dispatches")
Component(handler, "MoveTeamMemberHandler", "Application handler", "Correct membership and project assignments without reshuffling")
Component(entity, "Team", "Domain model", "Owns slice state")
}
ContainerDb(db, "Companion database", "SQL Server", "Durable state")
Rel(client, entry, "Calls through ITeamService")
Rel(entry, handler, "Dispatches")
Rel(handler, entity, "Uses")
Rel(handler, db, "Commits through application persistence contract")
@enduml
