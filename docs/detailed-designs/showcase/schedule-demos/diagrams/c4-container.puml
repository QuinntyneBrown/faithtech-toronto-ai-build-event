@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers - Schedule team demonstrations
Person(actor, "Administrator", "schedule demos")
System_Boundary(system, "FaithTech event platform") {
Container(ui, "Admin application", "Angular", "ScheduleDemosPage")
Container(api, "Event API", ".NET 10 / MediatR 12.5.0", "Validate demo intervals and preview a packed reorder before saving")
ContainerDb(db, "Event database", "SQL Server", "Team demo slots, presentation windows and schedule versions")
ContainerDb(redis, "Fanout backplane", "Redis; multiple API instances only", "Transient notification transport")
}
Rel(actor, ui, "Schedule demos")
Rel(ui, api, "Typed requests and state reads", "JSON / HTTPS")
Rel(api, db, "Commit or query scoped state", "EF Core")
Rel(api, redis, "EventHub fanout between instances")
Rel(api, ui, "Committed outbox invalidations through EventHub", "SignalR / HTTPS")

@enduml
