@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components - Schedule team demonstrations
Container(ui, "ScheduleDemosPage", "Angular / IDemoService", "Signals and typed service contract")
Container_Boundary(api, "Event API") {
Component(ctrl, "DemoController", "ASP.NET Core", "Bind, MediatR dispatch, return")
Component(gate, "SessionAuthorizationBehavior", "Application pipeline", "Validate actor, event and ownership")
Component(handler, "ScheduleDemosHandler", "Application", "Validate demo intervals and preview a packed reorder before saving")
Component(entity, "DemoSlot", "Domain", "Team demo slots, presentation windows and schedule versions")
Component(store, "SqlEventStore", "Infrastructure / IEventStore", "Feature queries, concurrency and transactions")
}
ContainerDb(db, "Event database", "SQL Server", "Team demo slots, presentation windows and schedule versions")
Rel(ui, ctrl, "Schedule demos", "HTTPS")
Rel(ctrl, gate, "Dispatch request through pipeline")
Rel(gate, handler, "Continue authorized request")
Rel(handler, entity, "Apply domain policy")
Rel(handler, store, "Load and persist through port")
Rel(store, db, "Query or commit", "EF Core")
@enduml
