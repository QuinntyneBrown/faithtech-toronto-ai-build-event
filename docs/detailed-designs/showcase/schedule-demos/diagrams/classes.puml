@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam classBackgroundColor #F9FAFB
skinparam classBorderColor #344054
skinparam sequenceMessageAlign center
skinparam maxMessageSize 180
title Structure - Schedule team demonstrations
interface IDemoService {
  +state: Signal<DemoScheduleView>
  +refresh(): Promise<void>
}
class DemoService {
  -http: HttpClient
  +refresh(): Promise<void>
}
class ScheduleDemosHandler {
  -store: IEventStore
  +Handle(request: SaveDemoSlotCommand): Task<DemoScheduleView>
}
interface IEventStore {
  +LoadAuthorized(scope: ActorEventScope): Task<DemoSlot>
  +Commit(intent: OperationContext): Task<CommitResult>
}
class DemoSlot {
  +Id: Guid
  +EventId: Guid
  +TeamId: Guid
  +ProjectId: Guid
  +StartsAtUtc: DateTimeOffset
  +DurationSeconds: int
  +EndsAtUtc(): DateTimeOffset
  +Move(start: DateTimeOffset): void
}
DemoService ..|> IDemoService
ScheduleDemosHandler --> IEventStore : queries / commits through
ScheduleDemosHandler --> DemoSlot : enforces policy on
class DemoOrderPreview {
  +SlotIds: Guid[]
  +ProposedStarts: DateTimeOffset[]
  +ScheduleVersion: string
}
class PresentationWindow {
  +StartsAtUtc: DateTimeOffset
  +EndsAtUtc: DateTimeOffset
}
DemoOrderPreview "1" o-- "0..*" DemoSlot : proposed ordering
PresentationWindow "1" --> "0..*" DemoSlot : contains

@enduml
