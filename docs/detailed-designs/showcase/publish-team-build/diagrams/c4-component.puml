@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components - Publish team build links and recap
Container(ui, "PublishTeamBuildPage", "Angular / IBuildService", "Signals and typed service contract")
Container_Boundary(api, "Event API") {
Component(ctrl, "BuildController", "ASP.NET Core", "Bind, MediatR dispatch, return")
Component(gate, "SessionAuthorizationBehavior", "Application pipeline", "Validate actor, event and ownership")
Component(handler, "PublishTeamBuildHandler", "Application", "Retain pairing-specific links and project one recap entry per team")
Component(entity, "TeamBuild", "Domain", "Event/team/project build pairings and current showcase projections")
Component(store, "SqlEventStore", "Infrastructure / IEventStore", "Feature queries, concurrency and transactions")
}
ContainerDb(db, "Event database", "SQL Server", "Event/team/project build pairings and current showcase projections")
Rel(ui, ctrl, "Publish team build", "HTTPS")
Rel(ctrl, gate, "Dispatch request through pipeline")
Rel(gate, handler, "Continue authorized request")
Rel(handler, entity, "Apply domain policy")
Rel(handler, store, "Load and persist through port")
Rel(store, db, "Query or commit", "EF Core")
@enduml
