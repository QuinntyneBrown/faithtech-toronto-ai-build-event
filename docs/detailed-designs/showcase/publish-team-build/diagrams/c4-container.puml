@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers - Publish team build links and recap
Person(actor, "Participant and administrator", "publish team build")
System_Boundary(system, "FaithTech event platform") {
Container(ui, "Client and admin applications", "Angular", "PublishTeamBuildPage")
Container(api, "Event API", ".NET 10 / MediatR 12.5.0", "Retain pairing-specific links and project one recap entry per team")
ContainerDb(db, "Event database", "SQL Server", "Event/team/project build pairings and current showcase projections")
ContainerDb(redis, "Fanout backplane", "Redis; multiple API instances only", "Transient notification transport")
}
Rel(actor, ui, "Publish team build")
Rel(ui, api, "Typed requests and state reads", "JSON / HTTPS")
Rel(api, db, "Commit or query scoped state", "EF Core")
Rel(api, redis, "EventHub fanout between instances")
Rel(api, ui, "Committed outbox invalidations through EventHub", "SignalR / HTTPS")

@enduml
