@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam classBackgroundColor #F9FAFB
skinparam classBorderColor #344054
skinparam sequenceMessageAlign center
skinparam maxMessageSize 180
title Structure - Publish team build links and recap
interface IBuildService {
  +state: Signal<TeamBuildView>
  +refresh(): Promise<void>
}
class BuildService {
  -http: HttpClient
  +refresh(): Promise<void>
}
class PublishTeamBuildHandler {
  -store: IEventStore
  +Handle(request: SaveTeamBuildCommand): Task<TeamBuildView>
}
interface IEventStore {
  +LoadAuthorized(scope: ActorEventScope): Task<TeamBuild>
  +Commit(intent: OperationContext): Task<CommitResult>
}
class TeamBuild {
  +EventId: Guid
  +TeamId: Guid
  +ProjectId: Guid
  +RepositoryUrl: Uri?
  +DemoUrl: Uri?
  +SetLinks(repository: Uri?, demo: Uri?): ValidationResult
}
BuildService ..|> IBuildService
PublishTeamBuildHandler --> IEventStore : queries / commits through
PublishTeamBuildHandler --> TeamBuild : enforces policy on
class TeamShowcaseEntry {
  +TeamId: Guid
  +TeamName: string
  +SelectedProjectId: Guid?
  +ProjectName: string?
  +DemoStartsAtUtc: DateTimeOffset?
  +RepositoryUrl: Uri?
  +DemoUrl: Uri?
}
TeamShowcaseEntry ..> TeamBuild : current pairing only

@enduml
