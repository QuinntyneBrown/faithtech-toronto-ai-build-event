@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam classBackgroundColor #F9FAFB
skinparam classBorderColor #344054
skinparam sequenceMessageAlign center
skinparam maxMessageSize 180
title Revoke authority and conceal private browser state
actor "Participant and administrator" as actor
box "Frontend - Client and admin applications" #E0F2FE
participant "ProtectAccessPage" as page
participant "ISessionService" as client
end box
box "Backend - Event API" #D1FADF
participant "SessionController" as controller
end box
box "Backend - Application and Domain" #ECFDF3
participant "Authorization / validation pipeline" as gate
participant "ProtectAccessHandler" as handler
participant "AuthorizationScope" as entity
end box
box "Backend - Infrastructure" #FFF4E5
database "SQL Server / IEventStore" as db
participant "OutboxDispatcher / EventHub" as push
end box
actor -> page : Sign out or receive credential-replacement notice
page -> client : Clear private signals and drafts [L2-041]
push -> db : Read committed session revocation invalidation
db --> push : Session audience and resource metadata only
push -> client : Revalidate or clear private view
client -> controller : Session check / protected request
controller -> gate : Validate SQL session authority
gate -> db : Read current revocation and active state
db --> gate : Revoked or expired
gate --> controller : Authentication required
controller --> client : 401 and no private projection
client --> page : Conceal private routes; offer fresh authentication
opt Restored tab or history navigation
page -> page : Hide cached private content before validation
end
@enduml
