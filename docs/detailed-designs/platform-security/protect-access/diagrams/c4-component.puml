@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components - Protect event access and private state
Container(ui, "ProtectAccessPage", "Angular / ISessionService", "Signals and typed service contract")
Container_Boundary(api, "Event API") {
Component(ctrl, "SessionController", "ASP.NET Core", "Bind, MediatR dispatch, return")
Component(gate, "SessionAuthorizationBehavior", "Application pipeline", "Validate actor, event and ownership")
Component(handler, "ProtectAccessHandler", "Application", "Enforce every resource boundary and keep credentials out of public state")
Component(entity, "AuthorizationScope", "Domain", "SQL session authority, credential digests and scoped resource relationships")
Component(store, "SqlEventStore", "Infrastructure / IEventStore", "Feature queries, concurrency and transactions")
}
ContainerDb(db, "Event database", "SQL Server", "SQL session authority, credential digests and scoped resource relationships")
Rel(ui, ctrl, "Protect access", "HTTPS")
Rel(ctrl, gate, "Dispatch request through pipeline")
Rel(gate, handler, "Continue authorized request")
Rel(handler, entity, "Apply domain policy")
Rel(handler, store, "Load and persist through port")
Rel(store, db, "Query or commit", "EF Core")
@enduml
