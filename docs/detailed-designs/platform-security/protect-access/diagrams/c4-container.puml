@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers - Protect event access and private state
Person(actor, "Participant and administrator", "protect access")
System_Boundary(system, "FaithTech event platform") {
Container(ui, "Client and admin applications", "Angular", "ProtectAccessPage")
Container(api, "Event API", ".NET 10 / MediatR 12.5.0", "Enforce every resource boundary and keep credentials out of public state")
ContainerDb(db, "Event database", "SQL Server", "SQL session authority, credential digests and scoped resource relationships")
ContainerDb(redis, "Fanout backplane", "Redis; multiple API instances only", "Transient notification transport")
}
Rel(actor, ui, "Protect access")
Rel(ui, api, "Typed requests and state reads", "JSON / HTTPS")
Rel(api, db, "Commit or query scoped state", "EF Core")
Rel(api, redis, "EventHub fanout between instances")
Rel(api, ui, "Committed outbox invalidations through EventHub", "SignalR / HTTPS")

@enduml
