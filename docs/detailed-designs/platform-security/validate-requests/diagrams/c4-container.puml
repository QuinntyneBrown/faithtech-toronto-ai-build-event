@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers - Validate input and enforce abuse limits
Person(actor, "Participant and administrator", "validate requests")
System_Boundary(system, "FaithTech event platform") {
Container(ui, "Client and admin applications", "Angular", "ValidateRequestsPage")
Container(api, "Event API", ".NET 10 / MediatR 12.5.0", "Validate literal content and enforce shared rolling limits before side effects")
ContainerDb(db, "Event database", "SQL Server", "SQL failure/send timestamps and validated input outcomes")
ContainerDb(redis, "Fanout backplane", "Redis; multiple API instances only", "Transient notification transport")
}
Rel(actor, ui, "Validate requests")
Rel(ui, api, "Typed requests and state reads", "JSON / HTTPS")
Rel(api, db, "Commit or query scoped state", "EF Core")
Rel(api, redis, "EventHub fanout between instances")
Rel(api, ui, "Committed outbox invalidations through EventHub", "SignalR / HTTPS")

@enduml
