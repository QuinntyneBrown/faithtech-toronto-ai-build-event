@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam classBackgroundColor #F9FAFB
skinparam classBorderColor #344054
skinparam sequenceMessageAlign center
skinparam maxMessageSize 180
title Structure - Shared validation and abuse limits
class RequestValidationBehavior {
  +Handle(request: RequestInput): Task<RequestResult>
}
interface IRequestValidator {
  +Validate(input: RequestInput): ValidationResult
}
class TextRules {
  +Normalize(value: string): string
  +CountScalars(value: string): int
}
class LogoValidator {
  +Decode(input: Stream, mediaType: string): Task<ValidatedLogo>
}
interface IAbuseLimitStore {
  +Evaluate(keys: LimitKey[], now: DateTimeOffset): Task<LimitDecision>
  +RecordOutcome(outcome: AttemptOutcome): Task<void>
}
class SqlAbuseLimitStore {
  +Evaluate(keys: LimitKey[], now: DateTimeOffset): Task<LimitDecision>
}
class ValidationResult {
  +Accepted: bool
  +Errors: FieldError[]
}
class ValidatedLogo {
  +Bytes: byte[]
  +MediaType: string
  +Width: int
  +Height: int
}
RequestValidationBehavior --> IRequestValidator : applies typed validators
RequestValidationBehavior --> IAbuseLimitStore : applicable authentication / send policy
SqlAbuseLimitStore ..|> IAbuseLimitStore
IRequestValidator ..> TextRules : shared literal content rules
IRequestValidator --> ValidationResult : returns
LogoValidator --> ValidatedLogo : bounded successful decode

@enduml
