@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Authenticate administrators within the companion — components
Container(client, "AppComponent", "Companion Angular client", "Presents this capability")
Container_Boundary(api, "Companion API") {
Component(entry, "AdministratorSessionController", "ASP.NET Core controller", "Binds inputs and dispatches")
Component(handler, "AuthenticateAdministratorHandler", "Application handler", "Enable same-screen controls through a bounded shared-code session")
Component(entity, "AdministratorSession", "Domain model", "Owns slice state")
}
ContainerDb(db, "Companion database", "SQL Server", "Durable state")
Rel(client, entry, "Calls through ISessionService")
Rel(entry, handler, "Dispatches")
Rel(handler, entity, "Uses")
Rel(handler, db, "Commits through application persistence contract")
@enduml
