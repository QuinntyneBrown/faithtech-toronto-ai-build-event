@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam classBackgroundColor #F9FAFB
skinparam classBorderColor #344054
skinparam sequenceMessageAlign center
skinparam maxMessageSize 180
title Structure - Manage participant and administrator sessions
interface ISessionService {
  +state: Signal<SessionState>
  +refresh(): Promise<void>
}
class SessionService {
  -http: HttpClient
  +refresh(): Promise<void>
}
class ManageSessionsHandler {
  -store: ISessionStore
  +Handle(request: GetSessionQuery): Task<SessionState>
}
interface ISessionStore {
  +LoadAuthorized(scope: ActorEventScope): Task<Session>
  +Commit(intent: OperationContext): Task<CommitResult>
}
class Session {
  +Id: Guid
  +ActorId: Guid
  +EventId: Guid?
  +Kind: SessionKind
  +AuthenticatedAtUtc: DateTimeOffset
  +LastInteractionAtUtc: DateTimeOffset
  +RevokedAtUtc: DateTimeOffset?
  +IsValid(now: DateTimeOffset): bool
  +RecordInteraction(now: DateTimeOffset): void
  +Revoke(now: DateTimeOffset): void
}
SessionService ..|> ISessionService
ManageSessionsHandler --> ISessionStore : queries / commits through
ManageSessionsHandler --> Session : enforces policy on
enum SessionKind {
  Participant
  Administrator
}
class AdministratorAccount {
  +Id: Guid
  +NormalizedUserName: string
  +Enabled: bool
}
Session --> SessionKind
AdministratorAccount "1" --> "0..*" Session

@enduml
