{
  "compilerOptions": {
    "target": "ES2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "strict": true,
    "experimentalDecorators": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "lib": ["ES2022", "dom"],
    "baseUrl": ".",
    "paths": {
      "@faithtech/api": ["projects/api/src/public-api.ts"],
      "@faithtech/components": ["projects/components/src/public-api.ts"],
      "@faithtech/domain": ["projects/domain/src/public-api.ts"]
    }
  },
  "angularCompilerOptions": {
    "strictTemplates": true,
    "strictInjectionParameters": true
  }
}
